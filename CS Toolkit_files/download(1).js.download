/* Cambridge pseudocode interpreter (IGCSE 0478 and AS/A Level 9618 style).
   Pure logic, no DOM. Works in the browser (window.Pseudo) and in Node (module.exports). */
(function (root) {
  'use strict';

  var KEYWORDS = ('DECLARE CONSTANT INPUT OUTPUT IF THEN ELSE ENDIF CASE OF OTHERWISE ENDCASE FOR TO STEP NEXT ' +
    'WHILE DO ENDWHILE REPEAT UNTIL PROCEDURE ENDPROCEDURE FUNCTION RETURNS ENDFUNCTION RETURN CALL AND OR NOT ' +
    'DIV MOD TRUE FALSE ARRAY INTEGER REAL CHAR STRING BOOLEAN DATE BYREF BYVAL TYPE ENDTYPE OPENFILE READFILE ' +
    'WRITEFILE CLOSEFILE READ WRITE APPEND').split(' ');
  var KW = {};
  KEYWORDS.forEach(function (k) { KW[k] = true; });
  var BASE_TYPES = { INTEGER: 1, REAL: 1, CHAR: 1, STRING: 1, BOOLEAN: 1, DATE: 1 };

  function PseudoError(message, line) {
    this.name = 'PseudoError';
    this.message = message;
    this.line = line || 0;
  }
  PseudoError.prototype = Object.create(Error.prototype);

  /* ---------- Tokenizer ---------- */
  function tokenize(src) {
    var lines = src.replace(/\r\n?/g, '\n').split('\n');
    var toks = [];
    for (var ln = 0; ln < lines.length; ln++) {
      var s = lines[ln].replace(/[“”]/g, '"').replace(/[‘’]/g, "'");
      var i = 0, n = s.length, lineNo = ln + 1, count = 0;
      while (i < n) {
        var c = s[i];
        if (c === ' ' || c === '\t') { i++; continue; }
        if (c === '/' && s[i + 1] === '/') break;
        var m;
        if (c === '"') {
          var j = s.indexOf('"', i + 1);
          if (j < 0) throw new PseudoError('This string is missing its closing quote (").', lineNo);
          toks.push({ t: 'str', v: s.slice(i + 1, j), line: lineNo }); i = j + 1; count++; continue;
        }
        if (c === "'") {
          var j2 = s.indexOf("'", i + 1);
          if (j2 < 0) throw new PseudoError("This character is missing its closing quote (').", lineNo);
          var body = s.slice(i + 1, j2);
          if (body.length !== 1) throw new PseudoError("A CHAR holds exactly one character in single quotes, like 'A'. Use double quotes for a STRING.", lineNo);
          toks.push({ t: 'chr', v: body, line: lineNo }); i = j2 + 1; count++; continue;
        }
        if ((m = /^\d+(\.\d+)?/.exec(s.slice(i)))) {
          toks.push({ t: 'num', v: parseFloat(m[0]), real: !!m[1], line: lineNo }); i += m[0].length; count++; continue;
        }
        if ((m = /^[A-Za-z_][A-Za-z0-9_]*/.exec(s.slice(i)))) {
          var w = m[0];
          toks.push({ t: KW[w] ? 'kw' : 'id', v: w, line: lineNo }); i += w.length; count++; continue;
        }
        var two = s.slice(i, i + 2);
        if (two === '<-') { toks.push({ t: 'op', v: '←', line: lineNo }); i += 2; count++; continue; }
        if (two === '<=' || two === '>=' || two === '<>') { toks.push({ t: 'op', v: two, line: lineNo }); i += 2; count++; continue; }
        if (c === '←') { toks.push({ t: 'op', v: '←', line: lineNo }); i++; count++; continue; }
        if (c === '≤') { toks.push({ t: 'op', v: '<=', line: lineNo }); i++; count++; continue; }
        if (c === '≥') { toks.push({ t: 'op', v: '>=', line: lineNo }); i++; count++; continue; }
        if (c === '≠') { toks.push({ t: 'op', v: '<>', line: lineNo }); i++; count++; continue; }
        if ('=<>+-*/^&()[],:.'.indexOf(c) >= 0) { toks.push({ t: 'op', v: c, line: lineNo }); i++; count++; continue; }
        throw new PseudoError('I do not recognise the symbol "' + c + '".', lineNo);
      }
      if (count) toks.push({ t: 'nl', line: lineNo });
    }
    toks.push({ t: 'eof', line: lines.length });
    return toks;
  }

  /* ---------- Parser ---------- */
  function Parser(toks) { this.toks = toks; this.p = 0; }
  var P = Parser.prototype;
  P.peek = function (o) { return this.toks[this.p + (o || 0)]; };
  P.next = function () { return this.toks[this.p++]; };
  P.isKw = function (v, o) { var t = this.peek(o); return t.t === 'kw' && t.v === v; };
  P.isOp = function (v, o) { var t = this.peek(o); return t.t === 'op' && t.v === v; };
  P.describe = function (t) {
    if (t.t === 'nl') return 'the end of the line';
    if (t.t === 'eof') return 'the end of the program';
    if (t.t === 'str') return '"' + t.v + '"';
    return '"' + t.v + '"';
  };
  P.fail = function (msg, t) {
    t = t || this.peek();
    // Hint when a keyword was typed in lower case somewhere on the line.
    var hint = '';
    for (var i = 0; i < this.toks.length; i++) {
      var k = this.toks[i];
      if (k.line === t.line && k.t === 'id' && KW[k.v.toUpperCase()] && k.v !== k.v.toUpperCase() &&
          ['IF', 'THEN', 'ELSE', 'ENDIF', 'FOR', 'NEXT', 'WHILE', 'ENDWHILE', 'REPEAT', 'UNTIL', 'OUTPUT', 'INPUT', 'DECLARE', 'DO'].indexOf(k.v.toUpperCase()) >= 0) {
        hint = ' Keywords are written in capitals: ' + k.v.toUpperCase() + '.'; break;
      }
    }
    throw new PseudoError(msg + hint, t.line);
  };
  P.expectKw = function (v, ctx) {
    if (!this.isKw(v)) this.fail('Expected ' + v + (ctx ? ' ' + ctx : '') + ' but found ' + this.describe(this.peek()) + '.');
    return this.next();
  };
  P.expectOp = function (v, ctx) {
    if (!this.isOp(v)) this.fail('Expected "' + v + '"' + (ctx ? ' ' + ctx : '') + ' but found ' + this.describe(this.peek()) + '.');
    return this.next();
  };
  P.expectId = function (ctx) {
    var t = this.peek();
    if (t.t !== 'id') this.fail('Expected a name' + (ctx ? ' ' + ctx : '') + ' but found ' + this.describe(t) + '.');
    return this.next();
  };
  P.skipNl = function () { while (this.peek().t === 'nl') this.p++; };

  P.parseProgram = function () {
    var body = this.parseBlock([]);
    if (this.peek().t !== 'eof') this.fail('Unexpected ' + this.describe(this.peek()) + '. It does not match any open block.');
    return body;
  };

  P.parseBlock = function (enders) {
    var out = [];
    for (;;) {
      this.skipNl();
      var t = this.peek();
      if (t.t === 'eof') {
        if (enders.length) this.fail('The program ended but ' + enders[enders.length - 1] + ' is missing.', t);
        return out;
      }
      if (t.t === 'kw' && enders.indexOf(t.v) >= 0) return out;
      out.push(this.parseStatement());
    }
  };

  P.parseType = function () {
    var t = this.peek();
    if (t.t === 'kw' && t.v === 'ARRAY') {
      this.next();
      var dims = [];
      if (this.isOp('[')) {
        this.next();
        do {
          var lo = this.parseExpr(); this.expectOp(':', 'between the array bounds, like ARRAY[1:10]');
          var hi = this.parseExpr(); dims.push([lo, hi]);
        } while (this.isOp(',') && this.next());
        this.expectOp(']');
      }
      this.expectKw('OF', 'after the array bounds');
      return { array: true, dims: dims, of: this.parseType() };
    }
    if (t.t === 'kw' && BASE_TYPES[t.v]) { this.next(); return { base: t.v }; }
    if (t.t === 'id') { this.next(); return { base: t.v, record: true }; }
    this.fail('Expected a data type (INTEGER, REAL, CHAR, STRING, BOOLEAN) but found ' + this.describe(t) + '.');
  };

  P.parseParams = function () {
    var params = [];
    if (!this.isOp('(')) return params;
    this.next();
    var mode = 'BYVAL';
    if (!this.isOp(')')) {
      do {
        if (this.isKw('BYREF') || this.isKw('BYVAL')) mode = this.next().v;
        var name = this.expectId('for the parameter').v;
        this.expectOp(':', 'then the parameter type');
        params.push({ name: name, type: this.parseType(), mode: mode });
      } while (this.isOp(',') && this.next());
    }
    this.expectOp(')');
    return params;
  };

  P.parseFileName = function () {
    var t = this.peek();
    if (t.t === 'str') { this.next(); return { k: 'lit', v: t.v }; }
    var s = '';
    while (this.peek().t === 'id' || this.isOp('.')) s += this.next().v;
    if (!s) this.fail('Expected a file name here.');
    return { k: 'lit', v: s };
  };

  P.lineHasColon = function () {
    var depth = 0;
    for (var i = this.p; ; i++) {
      var t = this.toks[i];
      if (t.t === 'nl' || t.t === 'eof') return false;
      if (t.t === 'op') {
        if (t.v === '(' || t.v === '[') depth++;
        else if (t.v === ')' || t.v === ']') depth--;
        else if (t.v === ':' && depth === 0) return true;
      }
    }
  };

  P.parseStatement = function () {
    var t = this.peek(), line = t.line, self = this;
    if (t.t === 'kw') {
      switch (t.v) {
        case 'DECLARE': {
          this.next();
          var names = [this.expectId('after DECLARE').v];
          while (this.isOp(',')) { this.next(); names.push(this.expectId().v); }
          this.expectOp(':', 'then the data type, like DECLARE Total : INTEGER');
          return { k: 'declare', names: names, type: this.parseType(), line: line };
        }
        case 'CONSTANT': {
          this.next();
          var cn = this.expectId('after CONSTANT').v;
          if (this.isOp('=') || this.isOp('←')) this.next(); else this.fail('Expected = after the constant name, like CONSTANT Pi = 3.14');
          return { k: 'const', name: cn, expr: this.parseExpr(), line: line };
        }
        case 'INPUT': {
          this.next();
          var targets = [this.parseLvalue()];
          while (this.isOp(',')) { this.next(); targets.push(this.parseLvalue()); }
          return { k: 'input', targets: targets, line: line };
        }
        case 'OUTPUT': {
          this.next();
          var items = [this.parseExpr()];
          while (this.isOp(',')) { this.next(); items.push(this.parseExpr()); }
          return { k: 'output', items: items, line: line };
        }
        case 'IF': {
          this.next();
          var cond = this.parseExpr();
          this.skipNl(); this.expectKw('THEN', 'after the IF condition');
          var thenB = this.parseBlock(['ELSE', 'ENDIF']), elseB = null;
          if (this.isKw('ELSE')) { this.next(); elseB = this.parseBlock(['ENDIF']); }
          this.expectKw('ENDIF');
          return { k: 'if', cond: cond, then: thenB, else: elseB, line: line };
        }
        case 'CASE': {
          this.next(); this.expectKw('OF', 'after CASE');
          var subj = this.parseExpr(), clauses = [], other = null;
          for (;;) {
            this.skipNl();
            if (this.isKw('ENDCASE')) { this.next(); break; }
            if (this.peek().t === 'eof') this.fail('The program ended but ENDCASE is missing.');
            if (this.isKw('OTHERWISE')) {
              this.next(); if (this.isOp(':')) this.next();
              other = this.parseCaseBody();
              continue;
            }
            if (!this.lineHasColon()) this.fail('Each CASE option needs a value then a colon, like  1 : OUTPUT "One"');
            var tests = [];
            do {
              var a = this.parseExpr();
              if (this.isKw('TO')) { this.next(); tests.push({ lo: a, hi: this.parseExpr() }); }
              else tests.push({ eq: a });
            } while (this.isOp(',') && this.next());
            this.expectOp(':');
            clauses.push({ tests: tests, body: this.parseCaseBody(), line: this.peek().line });
          }
          return { k: 'case', subj: subj, clauses: clauses, other: other, line: line };
        }
        case 'FOR': {
          this.next();
          var v = this.expectId('for the loop counter').v;
          this.expectOp('←', 'after the loop counter, like FOR Count ← 1 TO 10');
          var from = this.parseExpr(); this.expectKw('TO', 'in the FOR loop');
          var to = this.parseExpr(), step = null;
          if (this.isKw('STEP')) { this.next(); step = this.parseExpr(); }
          var body = this.parseBlock(['NEXT']);
          this.expectKw('NEXT');
          if (this.peek().t === 'id') {
            var nx = this.next();
            if (nx.v !== v) this.fail('This NEXT says "' + nx.v + '" but the loop counter is "' + v + '".', nx);
          }
          return { k: 'for', v: v, from: from, to: to, step: step, body: body, line: line };
        }
        case 'WHILE': {
          this.next();
          var wc = this.parseExpr();
          if (this.isKw('DO')) this.next();
          var wb = this.parseBlock(['ENDWHILE']); this.expectKw('ENDWHILE');
          return { k: 'while', cond: wc, body: wb, line: line };
        }
        case 'REPEAT': {
          this.next();
          var rb = this.parseBlock(['UNTIL']);
          var ul = this.expectKw('UNTIL').line;
          return { k: 'repeat', body: rb, cond: this.parseExpr(), line: line, untilLine: ul };
        }
        case 'PROCEDURE': {
          this.next();
          var pn = this.expectId('for the procedure').v, pp = this.parseParams();
          var pb = this.parseBlock(['ENDPROCEDURE']); this.expectKw('ENDPROCEDURE');
          return { k: 'procdef', name: pn, params: pp, body: pb, line: line };
        }
        case 'FUNCTION': {
          this.next();
          var fn = this.expectId('for the function').v, fp = this.parseParams();
          this.expectKw('RETURNS', 'then the type the function gives back');
          var ft = this.parseType();
          var fb = this.parseBlock(['ENDFUNCTION']); this.expectKw('ENDFUNCTION');
          return { k: 'funcdef', name: fn, params: fp, returns: ft, body: fb, line: line };
        }
        case 'TYPE': {
          this.next();
          var tn = this.expectId('for the new type').v, fields = [];
          for (;;) {
            this.skipNl();
            if (this.isKw('ENDTYPE')) { this.next(); break; }
            this.expectKw('DECLARE', 'for each field inside TYPE');
            var fname = this.expectId().v; this.expectOp(':');
            fields.push({ name: fname, type: this.parseType() });
          }
          return { k: 'typedef', name: tn, fields: fields, line: line };
        }
        case 'RETURN': this.next(); return { k: 'return', expr: this.parseExpr(), line: line };
        case 'CALL': {
          this.next();
          var cname = this.expectId('after CALL').v, args = [];
          if (this.isOp('(')) {
            this.next();
            if (!this.isOp(')')) { do { args.push(this.parseExpr()); } while (this.isOp(',') && this.next()); }
            this.expectOp(')');
          }
          return { k: 'call', name: cname, args: args, line: line };
        }
        case 'OPENFILE': {
          this.next();
          var f = this.parseFileName(); this.expectKw('FOR', 'then READ, WRITE or APPEND');
          var md = this.peek();
          if (!(md.t === 'kw' && (md.v === 'READ' || md.v === 'WRITE' || md.v === 'APPEND'))) this.fail('Expected READ, WRITE or APPEND after FOR.');
          this.next();
          return { k: 'openfile', file: f, mode: md.v, line: line };
        }
        case 'READFILE': {
          this.next(); var rf = this.parseFileName(); this.expectOp(',', 'then the variable to read into');
          return { k: 'readfile', file: rf, target: this.parseLvalue(), line: line };
        }
        case 'WRITEFILE': {
          this.next(); var wf = this.parseFileName(); this.expectOp(',', 'then the data to write');
          return { k: 'writefile', file: wf, expr: this.parseExpr(), line: line };
        }
        case 'CLOSEFILE': this.next(); return { k: 'closefile', file: this.parseFileName(), line: line };
        case 'ELSE': case 'ENDIF': case 'NEXT': case 'ENDWHILE': case 'UNTIL': case 'ENDCASE':
        case 'ENDPROCEDURE': case 'ENDFUNCTION': case 'OTHERWISE': case 'THEN': case 'ENDTYPE':
          this.fail(t.v + ' appears here without a matching opening statement.');
      }
      this.fail('A statement cannot start with ' + t.v + '.');
    }
    if (t.t === 'id') {
      var target = this.parseLvalue();
      if (this.isOp('=')) this.fail('Use ← (type <-) to assign a value. The = sign only compares.');
      if (!this.isOp('←')) {
        if (target.k === 'var' && this.isOp('(')) this.fail('To run a procedure write CALL ' + target.name + '(...)');
        this.fail('Expected ← (type <-) after "' + (target.name || 'the variable') + '" but found ' + this.describe(this.peek()) + '.');
      }
      this.next();
      return { k: 'assign', target: target, expr: self.parseExpr(), line: line };
    }
    this.fail('A statement cannot start with ' + this.describe(t) + '.');
  };

  P.parseCaseBody = function () {
    // Statements for one CASE option: up to the next option, OTHERWISE or ENDCASE.
    var out = [];
    for (;;) {
      var hadNl = false;
      while (this.peek().t === 'nl') { this.p++; hadNl = true; }
      if (this.isKw('ENDCASE') || this.isKw('OTHERWISE') || this.peek().t === 'eof') return out;
      if (hadNl && out.length && this.lineHasColon() && !this.isKw('DECLARE')) return out;
      if (hadNl && !out.length && this.lineHasColon() && !this.isKw('DECLARE')) return out;
      out.push(this.parseStatement());
    }
  };

  P.parseLvalue = function () {
    var t = this.expectId();
    var node = { k: 'var', name: t.v, line: t.line };
    for (;;) {
      if (this.isOp('[')) {
        this.next();
        var idx = [this.parseExpr()];
        while (this.isOp(',')) { this.next(); idx.push(this.parseExpr()); }
        this.expectOp(']');
        node = { k: 'index', base: node, idx: idx, line: t.line };
      } else if (this.isOp('.') && this.peek(1).t === 'id') {
        this.next();
        node = { k: 'field', base: node, name: this.next().v, line: t.line };
      } else return node;
    }
  };

  P.parseExpr = function () { return this.parseOr(); };
  P.parseOr = function () {
    var l = this.parseAnd();
    while (this.isKw('OR')) { var t = this.next(); l = { k: 'bin', op: 'OR', l: l, r: this.parseAnd(), line: t.line }; }
    return l;
  };
  P.parseAnd = function () {
    var l = this.parseNot();
    while (this.isKw('AND')) { var t = this.next(); l = { k: 'bin', op: 'AND', l: l, r: this.parseNot(), line: t.line }; }
    return l;
  };
  P.parseNot = function () {
    if (this.isKw('NOT')) { var t = this.next(); return { k: 'un', op: 'NOT', e: this.parseNot(), line: t.line }; }
    return this.parseCmp();
  };
  P.parseCmp = function () {
    var l = this.parseAdd();
    for (;;) {
      var t = this.peek();
      if (t.t === 'op' && ['=', '<>', '<', '>', '<=', '>='].indexOf(t.v) >= 0) {
        this.next(); l = { k: 'bin', op: t.v, l: l, r: this.parseAdd(), line: t.line };
      } else return l;
    }
  };
  P.parseAdd = function () {
    var l = this.parseMul();
    for (;;) {
      var t = this.peek();
      if (t.t === 'op' && (t.v === '+' || t.v === '-' || t.v === '&')) {
        this.next(); l = { k: 'bin', op: t.v, l: l, r: this.parseMul(), line: t.line };
      } else return l;
    }
  };
  P.parseMul = function () {
    var l = this.parseUnary();
    for (;;) {
      var t = this.peek();
      if ((t.t === 'op' && (t.v === '*' || t.v === '/')) || (t.t === 'kw' && (t.v === 'DIV' || t.v === 'MOD'))) {
        this.next(); l = { k: 'bin', op: t.v, l: l, r: this.parseUnary(), line: t.line };
      } else return l;
    }
  };
  P.parseUnary = function () {
    if (this.isOp('-')) { var t = this.next(); return { k: 'un', op: '-', e: this.parseUnary(), line: t.line }; }
    if (this.isOp('+')) { this.next(); return this.parseUnary(); }
    return this.parsePow();
  };
  P.parsePow = function () {
    var b = this.parsePrimary();
    if (this.isOp('^')) { var t = this.next(); return { k: 'bin', op: '^', l: b, r: this.parseUnary(), line: t.line }; }
    return b;
  };
  P.parsePrimary = function () {
    var t = this.peek();
    if (t.t === 'num') { this.next(); return { k: 'lit', v: t.v, real: t.real, line: t.line }; }
    if (t.t === 'str' || t.t === 'chr') { this.next(); return { k: 'lit', v: t.v, line: t.line }; }
    if (t.t === 'kw' && (t.v === 'TRUE' || t.v === 'FALSE')) { this.next(); return { k: 'lit', v: t.v === 'TRUE', line: t.line }; }
    if (t.t === 'op' && t.v === '(') {
      this.next(); var e = this.parseExpr(); this.expectOp(')', 'to close the bracket'); return e;
    }
    if (t.t === 'kw' && (t.v === 'DIV' || t.v === 'MOD') && this.isOp('(', 1)) {
      this.next(); this.next();
      var a = this.parseExpr(); this.expectOp(',', 'between the two values'); var b = this.parseExpr(); this.expectOp(')');
      return { k: 'bin', op: t.v, l: a, r: b, line: t.line };
    }
    if (t.t === 'id') {
      if (this.isOp('(', 1)) {
        this.next(); this.next();
        var args = [];
        if (t.v === 'EOF') { args.push(this.parseFileName()); }
        else if (!this.isOp(')')) { do { args.push(this.parseExpr()); } while (this.isOp(',') && this.next()); }
        this.expectOp(')', 'to close the brackets of ' + t.v);
        return { k: 'callf', name: t.v, args: args, line: t.line };
      }
      return this.parseLvalue();
    }
    this.fail('Expected a value here but found ' + this.describe(t) + '.');
  };

  /* ---------- Runtime ---------- */
  function fmt(v) {
    if (v === undefined) return '?';
    if (typeof v === 'boolean') return v ? 'TRUE' : 'FALSE';
    if (typeof v === 'number') {
      if (Number.isInteger(v)) return String(v);
      return String(parseFloat(v.toPrecision(12)));
    }
    if (v && v.arr) {
      var keys = [];
      if (v.dims.length === 1) {
        for (var i = v.dims[0][0]; i <= v.dims[0][1]; i++) keys.push(fmtCell(v.data[i]));
        return '[' + keys.join(', ') + ']';
      }
      var rows = [];
      for (var r = v.dims[0][0]; r <= v.dims[0][1]; r++) {
        var row = [];
        for (var c = v.dims[1][0]; c <= v.dims[1][1]; c++) row.push(fmtCell(v.data[r + ',' + c]));
        rows.push('[' + row.join(', ') + ']');
      }
      return '[' + rows.join(', ') + ']';
    }
    if (v && v.rec) {
      return '{' + Object.keys(v.fields).map(function (k) { return k + ': ' + fmtCell(v.fields[k].value); }).join(', ') + '}';
    }
    return String(v);
  }
  function fmtCell(v) {
    if (v === undefined) return '∅';
    if (typeof v === 'string') return '"' + v + '"';
    return fmt(v);
  }
  function typeName(type) {
    if (!type) return 'any';
    if (type.array) return 'ARRAY OF ' + typeName(type.of);
    return type.base;
  }
