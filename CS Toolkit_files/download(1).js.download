        if (this.frames.length > 400) this.err('Too many nested calls. Check that the recursion has a base case.', s.line);
        this.frames.push(frame);
        yield* this.block(def.body, frame);
        this.frames.pop();
        return null;
      }
      case 'return': {
        yield* this.tick(s.line);
        if (env === this.globals) this.err('RETURN can only be used inside a FUNCTION.', s.line);
        return { ret: yield* this.ev(s.expr, env) };
      }
      case 'openfile': {
        yield* this.tick(s.line);
        var fn = s.file.v;
        if (this.open[fn]) this.err('The file "' + fn + '" is already open.', s.line);
        if (s.mode === 'READ') {
          if (!this.files[fn]) this.err('There is no file called "' + fn + '" to read.', s.line);
          this.open[fn] = { mode: 'READ', pos: 0 };
        } else {
          if (s.mode === 'WRITE' || !this.files[fn]) this.files[fn] = [];
          this.open[fn] = { mode: s.mode };
        }
        return null;
      }
      case 'readfile': {
        yield* this.tick(s.line);
        var st = this.fileState(s.file.v, 'READ', s.line);
        if (st.pos >= this.files[s.file.v].length) this.err('Tried to read past the end of "' + s.file.v + '". Test EOF() before reading.', s.line);
        var rt = yield* this.ref(s.target, env, true);
        rt.set(this.convertInput(this.files[s.file.v][st.pos++], rt.type && rt.type.base !== 'STRING' ? rt.type : { base: 'STRING' }, s.line));
        return null;
      }
      case 'writefile': {
        yield* this.tick(s.line);
        this.fileState(s.file.v, 'WRITE', s.line);
        this.files[s.file.v].push(fmt(yield* this.ev(s.expr, env)));
        return null;
      }
      case 'closefile':
        yield* this.tick(s.line);
        if (!this.open[s.file.v]) this.err('The file "' + s.file.v + '" is not open.', s.line);
        delete this.open[s.file.v];
        return null;
    }
    this.err('Unknown statement.', s.line);
  };

  I.start = function () { return this.block(this.ast, this.globals); };

  // Variables visible right now: current procedure's locals first, then globals.
  I.snapshot = function () {
    var out = [], seen = {};
    var top = this.frames[this.frames.length - 1];
    function add(env, scope) {
      Object.keys(env.vars).forEach(function (n) {
        if (seen[n]) return; seen[n] = true;
        var c = env.vars[n];
        out.push({ name: n, scope: scope, value: c.value, text: c.value === undefined ? '' : fmt(c.value), isConst: !!c.isConst, type: c.type ? typeName(c.type) : '' });
      });
    }
    if (top !== this.globals) add(top, top.name);
    add(this.globals, 'global');
    return out;
  };

  /* Run to completion. inputs: array of strings or a function returning the next input. */
  function run(src, opts) {
    opts = opts || {};
    var lines = [], inputs = opts.inputs || [], ii = 0;
    var it = new Interp(src, {
      output: function (s) { lines.push(s); }, files: opts.files, strict: opts.strict,
      maxSteps: opts.maxSteps, random: opts.random
    });
    var g = it.start(), r = g.next();
    while (!r.done) {
      if (r.value.type === 'input') r = g.next(typeof inputs === 'function' ? inputs() : (ii < inputs.length ? inputs[ii++] : null));
      else r = g.next();
    }
    return { output: lines, files: it.files, interp: it };
  }

  var api = { Interp: Interp, PseudoError: PseudoError, run: run, fmt: fmt, tokenize: tokenize, KEYWORDS: KEYWORDS };
  if (typeof module !== 'undefined' && module.exports) module.exports = api;
  else root.Pseudo = api;
})(typeof window !== 'undefined' ? window : this);
