(function (T) { T.unit({ id: "7.1", title: "Digital citizens: safety, files and the school network", q: "How do I use computers safely, responsibly and efficiently?", lessons: [
{ t: "Getting started: logging in and lab routines", o: "I can log in to the school network and follow the computer room routines.",
  k: ["username: the name that identifies you on the network", "network: computers connected so they can share files and services", "log off: to end your session so nobody else can use your account"],
  d: ["Name three things you have used a computer, tablet or phone for this week.", "Any three sensible uses, for example homework, messaging, games, video."],
  s: ["Why we log in|Your account keeps your work separate from everyone else's|The network knows who you are, so it can show your files on any school computer|Anything done on your account is recorded as done by you",
      "Room routines|Enter, sit at your allocated computer and log in straight away|Screens down means stop, look and listen|Save your work, log off and tuck in your chair before you leave",
      "Looking after yourself|Sit with your back supported and feet flat|Top of the screen at eye level, about an arm's length away|Look away from the screen every 20 minutes"],
  a: "Complete the skills audit, then log in, open a word processor, type three sentences about yourself, save the file and log off. Support: follow the step-by-step login card. Stretch: find and write down three keyboard shortcuts you did not know.",
  w: [["What two things do you need to log in?", "A username and a password."], ["Why must you log off at the end of a lesson?", "So nobody else can use your account or change your work."], ["What does the signal 'screens down' mean?", "Stop work, lower or turn off the screen, and listen to the teacher."], ["Give two ways to sit safely at a computer.", "Any two: back supported, feet flat, screen at eye level, arm's length from screen, regular breaks."], ["Explain why the school gives every student a separate account instead of one shared account.", "Work stays private and separate, actions can be traced to one person, and each person can be given the right access."]],
  x: ["Why should you never tell a friend your password?", "They could use your account, and anything they do would look like you did it."] },
{ t: "Files, folders and naming conventions", o: "I can organise files in folders and give them sensible names.",
  k: ["file: a single saved piece of work, such as a document or image", "folder: a container that holds files and other folders", "file extension: the letters after the dot that show the file type, such as .docx"],
  d: ["Where do you keep your school books at home so you can find them quickly?", "Any organised system, for example one shelf or bag per subject. Files need the same idea."],
  s: ["Files and folders|A file is one piece of work|A folder groups related files|Folders can sit inside folders, making a tree",
      "Good file names|Say what is inside: `Y7-Science-Volcano-Report`|No spaces at the start, no symbols like / or ?|Add a version or date if you will make several: `v2` or `2026-09-14`",
      "File extensions|.docx is a document, .png is an image, .py is a Python program|The extension tells the computer which program to open|Changing the extension does not convert the file"],
  a: "On paper, design a folder tree for all your school subjects, with at least two levels. Then rename six badly named files from the list so their names say what is inside. Support: use the part-finished tree. Stretch: add a rule for version numbers and explain it.",
  w: [["What is the difference between a file and a folder?", "A file is one saved piece of work. A folder is a container for files and other folders."], ["Which is the better file name: `doc1` or `Y7-History-Castles-Essay`? Give a reason.", "The second, because it tells you the year, subject and content without opening it."], ["What type of file ends in .png?", "An image."], ["A file path is `Documents/Computing/Unit1/poster.png`. Name the folder that poster.png is saved in.", "Unit1."], ["Explain one problem that happens when everyone saves work with names like `untitled` or `homework`.", "Files are hard to find, easy to overwrite or mix up, and you cannot tell which version is correct."]],
  x: ["Write a good file name for your Year 7 Geography homework on rivers.", "For example Y7-Geography-Rivers-Homework."] },
{ t: "Lab: build your folder structure", o: "I can create folders, and save, move and find my work.",
  k: ["save: to store your work as a file so it is kept", "save as: to save a copy with a new name or in a new place", "path: the route through folders to a file"],
  d: ["Put these in order from biggest container to smallest: file, folder, drive.", "Drive, folder, file."],
  s: ["Create|Right-click, New, Folder, then type the name and press Enter|One folder per subject, then one per unit inside|Keep names short and clear",
      "Save and Save As|Save updates the file you already have|Save As makes a new copy: choose the folder first, then the name|Always check where you are saving before you click",
      "Find and move|Drag a file onto a folder to move it|Use the search box if you forget where a file is|Deleted files go to the recycle bin first"],
  a: "Build the folder tree you designed last lesson in your school account. Create a short document, save it in the right folder, make a second version with Save As, then move one file to a different folder. Support: work with the checklist and tick each step. Stretch: take a screenshot of your tree and label each level.",
  w: [["What is the difference between Save and Save As?", "Save updates the existing file. Save As creates a new copy with a new name or location."], ["You saved a file but cannot find it. Give two ways to locate it.", "Use search, check the recent files list, or look in the default Documents or Downloads folder."], ["Write the path to a file called `notes.docx` inside a folder `Unit1` inside a folder `Computing`.", "Computing/Unit1/notes.docx"], ["What happens to a file when you delete it from your documents?", "It moves to the recycle bin, where it can usually be restored."], ["A student keeps every file on the desktop. Explain two reasons this is a poor habit.", "Files are hard to find among many icons, they are not grouped by subject, and on shared computers the desktop may not follow you to another machine."]],
  x: ["Where exactly did you save today's document? Write its path.", "The student's own path, for example Computing/Unit1/About-Me-v2.docx."] },
{ t: "What makes a strong password?", o: "I can create a strong password and explain why it is strong.",
  k: ["password: a secret word or phrase that proves who you are", "brute-force attack: trying every possible password until one works", "passphrase: a password made from several unrelated words"],
  d: ["Which is harder to guess: `football` or `Purple7Kettle!Moon`? Why?", "The second: it is longer, mixes character types and is not a single common word."],
  s: ["How passwords are cracked|Guessing common passwords: `123456`, `password`, `qwerty`|Using personal facts: pet's name, birthday, team|Brute force: a program tries millions of combinations per second",
      "Length beats complexity|Every extra character multiplies the number of possible passwords|8 lower-case letters: about 200 billion combinations|12 mixed characters: far more than a program can try in a lifetime",
      "Building a strong password|Use three or four unrelated words: a passphrase|Add capitals, digits and symbols|Never reuse a password on another site"],
  a: "Rank the ten passwords on the sheet from weakest to strongest and justify the top and bottom choices. Then invent a passphrase method you could use (do not write down a real password). Support: sort into just three groups: weak, medium, strong. Stretch: calculate how many 4-digit PINs exist and how many 6-digit PINs exist.",
  w: [["Give two reasons why `123456` is a weak password.", "It is very common, short, and uses only digits in an obvious pattern."], ["What is a brute-force attack?", "A program tries every possible combination of characters until it finds the password."], ["Why does a longer password take longer to crack?", "Each extra character multiplies the number of combinations that must be tried."], ["List three types of character a strong password should include.", "Any three: upper-case letters, lower-case letters, digits, symbols."], ["A PIN has 4 digits. How many different PINs are possible? Show your working.", "10 x 10 x 10 x 10 = 10 000."]],
  x: ["State two rules you will follow for your own passwords from now on.", "Any two: long, mixed characters, not personal facts, different for each site, never shared."] },
{ t: "Two-factor authentication and password managers", o: "I can explain how two-factor authentication keeps an account safe.",
  k: ["authentication: checking that someone is who they say they are", "two-factor authentication (2FA): using two different kinds of proof to log in", "password manager: software that stores your passwords securely"],
  d: ["A thief learns your password. What could stop them getting into your account anyway?", "A second check, such as a code sent to your phone."],
  s: ["Three kinds of proof|Something you know: a password or PIN|Something you have: a phone or bank card|Something you are: a fingerprint or face",
      "Two-factor authentication|Combines two different kinds of proof|A stolen password alone is no longer enough|Example: bank card (have) plus PIN (know)",
      "Password managers|Store a different strong password for every site|You remember one master password only|The stored passwords are encrypted"],
  a: "For each of the eight login situations on the sheet, name the factors used and decide whether it is true two-factor authentication. Support: match each example to know, have or are using the cards. Stretch: explain why a password plus a security question is not two-factor.",
  w: [["What does 2FA stand for?", "Two-factor authentication."], ["Sort into know, have, are: fingerprint, PIN, phone, password, face.", "Know: PIN, password. Have: phone. Are: fingerprint, face."], ["A cash machine needs your card and your PIN. Which two factors are these?", "Something you have (card) and something you know (PIN)."], ["Give one advantage of using a password manager.", "You can use a different strong password on every site without remembering them all."], ["Explain why a password and a security question together are not two-factor authentication.", "Both are things you know, so they are the same kind of factor. Someone who can find out one can often find out the other."]],
  x: ["Name one account of yours that should have 2FA switched on, and say why.", "Any important account, for example email, because it can be used to reset other passwords."] },
{ t: "Lab: password strength investigation", o: "I can investigate password strength and present advice to others.",
  k: ["combination: one possible arrangement of characters", "character set: the group of characters a password may use", "audience: the people a piece of work is made for"],
  d: ["How many different 2-digit codes are there (00 to 99)?", "100, which is 10 x 10."],
  s: ["Counting combinations|Combinations = size of character set, multiplied once per character|Digits only, 4 long: 10 x 10 x 10 x 10 = 10 000|Lower-case letters, 4 long: 26 x 26 x 26 x 26 = 456 976",
      "What the numbers show|Adding one character multiplies the total|A bigger character set makes every position harder|Length matters most",
      "A good advice poster|One clear message in large text|Three rules a Year 6 pupil can follow|An example of a weak and a strong password (made up)"],
  a: "Use a spreadsheet to calculate the number of combinations for passwords of length 4, 6, 8 and 10 using digits only, then letters only. Design a one-page poster giving password advice to Year 6. Support: use the spreadsheet template with the formulas started. Stretch: add a column for a 62-character set (letters in both cases plus digits).",
  w: [["How many combinations does a 3-digit code have?", "10 x 10 x 10 = 1000."], ["How many 2-letter passwords can be made from lower-case letters?", "26 x 26 = 676."], ["Which gives more combinations: adding one more character, or adding one more symbol to the character set? ", "Adding one more character, because it multiplies the total by the size of the whole set."], ["Write one rule for your poster in 10 words or fewer.", "For example: Use three random words and never share your password."], ["A password uses only digits and is 6 long. A program tries 1000 passwords a second. How long would it take to try them all?", "1 000 000 combinations divided by 1000 = 1000 seconds, about 17 minutes."]],
  x: ["What is the single most important way to make a password stronger?", "Make it longer."] },
{ t: "Your digital footprint", o: "I can describe what a digital footprint is and how it is created.",
  k: ["digital footprint: the trail of data you leave when you use the internet", "active footprint: data you share on purpose, such as posts", "passive footprint: data collected about you without you posting it"],
  d: ["If someone searched your name online, what might they find?", "Open answers: photos, school or club pages, usernames, game profiles, or nothing yet."],
  s: ["What a footprint is|Every post, like, comment, search and sign-up adds to it|Active: things you choose to share|Passive: location, sites visited, devices used",
      "It lasts|Posts can be copied, screenshotted and shared|Deleting a post does not delete the copies|Schools and employers may look in the future",
      "Shape a positive footprint|Think before you post: would I be happy if a teacher saw this?|Share achievements, hobbies and kindness|Check what is public about you once a term"],
  a: "Sort the 16 online actions into active and passive footprint. Then draw your own footprint outline and fill it with the kinds of data you leave in a normal week (types only, no private details). Support: sort with a partner using the definitions card. Stretch: write a paragraph on who might use footprint data and why.",
  w: [["What is a digital footprint?", "The trail of data a person leaves behind when they use the internet."], ["Give one example of an active footprint and one of a passive footprint.", "Active: posting a photo or comment. Passive: a site recording your location or pages visited."], ["True or false: deleting a post removes it from the internet completely. Explain.", "False. Others may have copied, shared or screenshotted it, and the service may keep a copy."], ["Give two people or organisations that might look at someone's footprint in the future.", "For example a school, college, university or employer."], ["Describe two actions a Year 7 student could take to build a positive digital footprint.", "Any two: post respectfully, share achievements, keep accounts private, check and remove old posts, think before posting."]],
  x: ["Finish the sentence: Before I post something, I will ask myself...", "For example: would I be happy for my family or a teacher to see this in five years?"] },
{ t: "Privacy settings and oversharing", o: "I can decide what is safe to share online and use privacy settings.",
  k: ["personal data: information that identifies you, such as your address or date of birth", "privacy settings: controls that decide who can see your information", "oversharing: giving out more personal information than is safe"],
  d: ["Which of these would you tell a stranger in the street: your first name, your address, your school, your favourite food?", "Favourite food is harmless. Address and school should not be shared. First name depends on the situation."],
  s: ["Personal data|Full name, address, school, date of birth, phone number, location|Photos can reveal a uniform, a street sign or a house number|Small pieces add up to a full picture",
      "Privacy settings|Choose who sees posts: public, friends, only me|Turn off location tagging by default|Check settings after every app update",
      "Before you share|Who can see it?|What does it reveal about where I am or who I am?|Could it be used to find me or pretend to be me?"],
  a: "Study the made-up profile on the sheet. Highlight every piece of personal data it reveals and rewrite the profile so it is safe. Support: use the list of six things to look for. Stretch: write three privacy rules for a new social app aimed at 11-year-olds.",
  w: [["List four examples of personal data.", "Any four: full name, address, date of birth, school, phone number, location, photos."], ["What do privacy settings control?", "Who can see your profile, posts and information."], ["A photo shows a student in school uniform outside their house. Name two things it reveals.", "Which school they attend and what their house looks like or where it is."], ["Why is it risky to share your live location publicly?", "Strangers can tell where you are now, and that you are not at home."], ["Explain how several harmless-looking posts could be combined to identify where someone lives.", "A uniform shows the school, a tagged park shows the area, a photo of the front door shows the house. Together they narrow it down."]],
  x: ["Name one setting you will check on an app you use.", "For example who can see my posts, or location sharing."] },
{ t: "Lab: case study, tracing a fictional person", o: "I can show how scattered posts build a picture of a person.",
  k: ["evidence: information that supports a conclusion", "inference: a conclusion worked out from clues", "profile: a collected description of a person"],
  d: ["A post says 'Late for training again, the 42 bus never comes!' What can you infer?", "The person plays a sport, trains regularly and lives on the 42 bus route."],
  s: ["Be a digital detective|Read each made-up post carefully|Note every fact and every clue|Separate what is stated from what you infer",
      "Building the profile|Combine clues from different posts|Check that each conclusion has evidence|Rate each conclusion: certain, likely, guess",
      "Why this matters|Someone with bad intentions can do the same|Each post seemed harmless on its own|Fewer clues means a smaller picture"],
  a: "Using the 12 posts from the fictional student 'Sam', complete the profile sheet: name, age, school, area, routine and interests, with the evidence for each. Then write three pieces of advice for Sam. Support: work through the first four posts with the teacher. Stretch: identify which three posts gave away the most and explain why.",
  w: [["What is an inference?", "A conclusion worked out from clues, not stated directly."], ["Give one fact you could infer from a photo of a birthday cake with 12 candles posted today.", "The person's age and their date of birth."], ["Why is a post about a weekly routine risky?", "It tells others where the person will be at a certain time."], ["Give one piece of advice for Sam.", "For example make the account private, remove posts showing the school or street, turn off location tags."], ["Explain why removing just one post may not make Sam safe.", "Other posts still give clues that can be combined, and the removed post may already have been copied."]],
  x: ["Which is more revealing: one post, or the pattern across many posts? Why?", "The pattern, because clues combine to give a full picture."] },
{ t: "Phishing and scams: spot the signs", o: "I can recognise a phishing message and know what to do with it.",
  k: ["phishing: a fake message that tricks you into giving away personal data", "scam: a dishonest scheme to get money or information", "link: text or a button that takes you to a web page"],
  d: ["You get a message: 'You have won a new phone! Click here in the next 10 minutes.' What do you think?", "It is almost certainly a scam: unexpected prize, pressure to act fast, a link to click."],
  s: ["What phishing is|A message pretending to be from someone you trust|It wants a password, bank details or a click on a link|It can arrive by email, text or direct message",
      "Warning signs|Urgency or threats: 'act now or lose your account'|Greeting that is not your name: 'Dear customer'|Spelling mistakes and a sender address that does not match|A link that goes somewhere unexpected",
      "What to do|Do not click, do not reply|Check by going to the real site yourself|Report it to an adult or the service, then delete it"],
  a: "Annotate the four made-up messages on the sheet: circle every warning sign and label it. Decide which one is genuine. Support: use the checklist of five signs. Stretch: explain how a scammer could make a phishing message more convincing, and how you would still catch it.",
  w: [["What is phishing?", "A fake message that tries to trick someone into giving away personal data or clicking a harmful link."], ["Give three warning signs of a phishing email.", "Any three: urgency, generic greeting, spelling errors, strange sender address, unexpected link or attachment, too good to be true."], ["Why do scammers try to make you act quickly?", "So you do not have time to think or check whether the message is real."], ["You are not sure whether an email from your bank is real. What is the safest thing to do?", "Do not use the link. Go to the bank's real website or app yourself, or ask an adult."], ["Explain why 'Dear customer' is more suspicious than a message that uses your full name.", "A real organisation knows your name. A scammer sending thousands of messages does not."]],
  x: ["Write the three steps to take when you receive a suspicious message.", "Do not click or reply, check through the real site, report and delete."] },
{ t: "Cyberbullying: from bystander to upstander", o: "I can explain what cyberbullying is and how to respond to it.",
  k: ["cyberbullying: repeated, deliberate unkindness using technology", "bystander: someone who sees what is happening but does nothing", "upstander: someone who acts to support the person being targeted"],
  d: ["What is the difference between a joke and bullying?", "A joke is enjoyed by everyone including the person it is about. Bullying is repeated, unwanted and hurts."],
  s: ["What makes it cyberbullying|It is deliberate and repeated|It uses messages, images, group chats or games|It can follow someone home and reach a large audience fast",
      "If it happens to you|Do not reply or retaliate|Keep evidence: take screenshots|Block and report the account, and tell an adult you trust",
      "Be an upstander|Do not like, share or join in|Support the person privately|Report what you saw"],
  a: "In groups, read the three scenarios. For each, decide what the bystanders could do and act out the upstander version. Record your best response on the sheet. Support: choose from the response cards. Stretch: write a short code of conduct for a class group chat.",
  w: [["Give two features that make behaviour bullying and not a one-off argument.", "It is deliberate and it is repeated."], ["List three things to do if you are cyberbullied.", "Do not reply, save evidence, block and report, tell a trusted adult (any three)."], ["Why should you take screenshots before blocking someone?", "To keep evidence that can be shown to an adult, the school or the service."], ["What is an upstander?", "Someone who sees bullying and acts to help the person targeted."], ["Explain why forwarding a hurtful image 'as a joke' makes someone part of the problem.", "It spreads the harm to more people, adds to the repetition, and shows the bully that others approve."]],
  x: ["Name one adult in school you could tell about cyberbullying.", "Any named trusted adult, for example a form tutor or head of year."] },
{ t: "Lab: safe or suspicious?", o: "I can judge messages and justify my decision with evidence.",
  k: ["justify: to give reasons for a decision", "sender address: the email address a message came from", "attachment: a file sent with a message"],
  d: ["An email from `support@paypa1.com` asks you to log in. What is wrong?", "The address uses the digit 1 instead of the letter l: it is a fake look-alike."],
  s: ["Check the sender|Read the whole address, not just the display name|Look for swapped letters and extra words|A real company uses its own domain",
      "Check the link|Hover or long-press to preview where it goes|Look at the main name before the first single slash|If in doubt, type the address yourself",
      "Check the request|Real services never ask for your password by message|Unexpected attachments are a risk|If it seems too good to be true, it is"],
  a: "Sort the 15 made-up messages into safe, suspicious or dangerous on the shared sorting board. For each one write the evidence for your decision. Support: decide for the first eight only. Stretch: create your own made-up phishing message with five hidden warning signs for a partner to find.",
  w: [["Which address is more likely to be genuine: `help@school.edu` or `school-help@freeprizes.net`? Why?", "The first, because it uses the organisation's own domain."], ["What should you do before clicking a link in a message?", "Preview where it leads and check the main site name."], ["Why can an unexpected attachment be dangerous?", "It may contain malware that installs when opened."], ["A message from a friend's account says 'Is this you in this video?' with a link. What might have happened?", "The friend's account may have been taken over and is being used to spread a scam."], ["Explain why you should judge a message by its evidence and not by how professional it looks.", "Logos and layouts are easy to copy. The sender address, the link and the request are much harder to fake."]],
  x: ["Give the piece of evidence you find most useful for spotting a fake.", "For example the sender address or where the link really goes."] },
{ t: "Searching well: keywords and operators", o: "I can use keywords and search tools to find information quickly.",
  k: ["search engine: a service that finds web pages matching your words", "keyword: an important word that describes what you want", "search operator: a symbol or word that narrows a search, such as quotation marks"],
  d: ["You want to know how tall Mount Everest is. What would you type?", "A few keywords, for example: Everest height metres."],
  s: ["How a search engine works|It keeps a huge index of pages it has visited|It matches your words to the index|It ranks results; adverts may appear first",
      "Better keywords|Use the important nouns: `volcano eruption causes`|Leave out small words like 'the' and 'of'|Add a detail: place, date or type",
      "Useful operators|Quotation marks find an exact phrase|A minus sign removes a word: `jaguar -car`|`site:` searches one website only"],
  a: "Complete the search challenge: answer the ten questions using the fewest searches you can, and record the keywords you used. Support: the first five questions have suggested keywords. Stretch: write two questions that need an operator to answer well, with the search you would use.",
  w: [["What is a keyword?", "An important word that describes what you are looking for."], ["Improve this search: `what is the reason that volcanoes erupt`.", "For example: volcano eruption causes."], ["What do quotation marks do in a search?", "They find the exact phrase inside them."], ["You search for jaguar and get cars. What search finds the animal?", "For example jaguar -car, or jaguar animal."], ["Explain why the first result is not always the best source.", "Results may be adverts or simply popular. Rank is not a check of accuracy."]],
  x: ["Write one search that uses an operator.", "Any correct use of quotation marks, minus or site:."] },
{ t: "Reliable or not? Evaluating sources", o: "I can judge whether a website is a reliable source.",
  k: ["reliable: can be trusted to be accurate", "bias: presenting only one side or a slanted view", "source: where a piece of information comes from"],
  d: ["Two websites give different heights for the same mountain. How could you decide which is right?", "Check who wrote each, when, and compare with a third trusted source."],
  s: ["Five questions|Who wrote it, and are they an expert?|Why was it written: to inform, sell or persuade?|When was it updated?|Does it give evidence or sources?|Do other trusted sites agree?",
      "Clues in the page|Named author and organisation|A recent date|Facts with references, not just opinions",
      "Take care|Anyone can publish a website|A professional design does not prove accuracy|A padlock means the connection is private, not that the content is true"],
  a: "Evaluate the three web pages provided using the five-question checklist and give each a reliability score out of 10 with reasons. Support: answer who, why and when only. Stretch: find a claim online, then find two other sources that confirm or contradict it.",
  w: [["Give three questions to ask about a website before you trust it.", "Any three: who wrote it, why, when, what evidence, do others agree."], ["What is bias?", "Presenting only one side, or a slanted view."], ["Why might a company's own website be biased about its products?", "Its purpose is to sell, so it may leave out weaknesses."], ["What does the padlock in the address bar tell you?", "That the connection to the site is encrypted. It does not tell you the information is true."], ["A page has no author, no date and no sources, but looks professional. Would you use it for homework? Explain.", "No, or only with checking. There is no way to judge who wrote it or whether it is current and accurate."]],
  x: ["What is the best single check for a surprising fact?", "See whether other trusted sources say the same."] },
{ t: "Lab: research with a source checklist", o: "I can research a question and record where my information came from.",
  k: ["reference: a note saying where information came from", "plagiarism: presenting someone else's work as your own", "paraphrase: to rewrite an idea in your own words"],
  d: ["Is it acceptable to copy a paragraph from a website into your homework? Why?", "No. It is plagiarism unless it is quoted and credited, and it does not show your own understanding."],
  s: ["Research steps|Write your question|Choose keywords and search|Open two or three results and apply the checklist",
      "Use it honestly|Make notes in your own words|Put quotation marks around anything copied exactly|Record the site name, page title and date you visited",
      "A good answer|Answers the question directly|Uses at least two reliable sources|Lists the references at the end"],
  a: "Research the question you are given (for example 'Why do computers use binary?'). Write a 100-word answer in your own words and list at least two references with a reliability note for each. Support: use the note-taking frame. Stretch: include one source you rejected and explain why.",
  w: [["What is plagiarism?", "Presenting someone else's work or words as your own."], ["What three details should a reference include?", "The site or author name, the page title and the date visited (accept the web address)."], ["Rewrite in your own words: 'A digital footprint is the trail of data left by internet users.'", "Any accurate paraphrase, for example: every time people go online they leave information behind that can be followed."], ["Why should you use more than one source?", "To check facts agree and to get a fuller picture."], ["Explain the difference between quoting and paraphrasing.", "Quoting copies the exact words inside quotation marks with credit. Paraphrasing restates the idea in your own words, still with credit."]],
  x: ["Write one reference you used today.", "A reference with site, title and date."] },
{ t: "Email etiquette and attachments", o: "I can write and send an appropriate email with an attachment.",
  k: ["subject line: a short title that says what the email is about", "CC: sends a copy to someone who needs to know", "etiquette: the polite and expected way to behave"],
  d: ["Which subject line is better: 'hi' or 'Year 7 Computing homework, question about task 2'?", "The second: the reader knows what it is about before opening it."],
  s: ["Parts of an email|To: the main reader. CC: a copy for information|Subject: short and specific|Greeting, message, sign-off with your name and class",
      "Writing to a teacher|Start with 'Dear Mr or Ms ...'|Full sentences, no text-speak, check spelling|Say what you need and by when",
      "Attachments|Attach the file before you write the message so you do not forget|Name the file clearly|Mention the attachment in the message"],
  a: "Write and send an email to your teacher asking a question about this unit, attaching the document you saved in week 1. Then improve the three badly written emails on the sheet. Support: use the email frame. Stretch: write the same message twice, once for a teacher and once for a friend, and list the differences.",
  w: [["What is the subject line for?", "To tell the reader what the email is about before they open it."], ["What does CC do?", "Sends a copy to another person for their information."], ["Rewrite politely: 'wheres my homework mark'.", "For example: Dear Ms Lee, please could you tell me my mark for the homework handed in last week? Thank you, Sam, 7B."], ["Give two things to check before pressing Send.", "Any two: correct recipient, subject line, spelling, attachment included, polite tone."], ["Explain why 'Reply all' should be used carefully.", "Everyone on the list receives the reply, which may share information with people who do not need it and fills their inboxes."]],
  x: ["List the four parts of a well-written email in order.", "Subject, greeting, message, sign-off."] },
{ t: "Assessed task: Stay Safe guide for Year 6", o: "I can apply what I know to give clear, accurate online safety advice.",
  k: ["success criteria: what your work must include to succeed", "audience: who the work is for", "accurate: correct and free from mistakes"],
  d: ["Name the three topics you feel most confident about from this unit.", "Any three from passwords, footprint, privacy, phishing, cyberbullying, searching, reliability, email."],
  s: ["The task|Make a one-page guide for Year 6 pupils joining the school|Cover passwords, personal data, phishing and where to get help|It must be your own work",
      "Success criteria|Advice is accurate and uses the correct key words|The language suits a 10-year-old|Layout is clear: headings, short points, one image or icon per section",
      "Use your time|5 minutes to plan the four sections|30 minutes to make it|5 minutes to check against the criteria and save with a sensible file name"],
  a: "Create your one-page Stay Safe guide for Year 6, working alone. Save it with a sensible name in your Unit 1 folder. Support: use the four-box planning frame. Stretch: add a 'myth or fact' section with three common misunderstandings corrected.",
  w: [["Write one piece of password advice for a 10-year-old in a single sentence.", "For example: Make your password long by joining three random words, and never tell anyone."], ["Name two kinds of personal data they should not share.", "Any two: address, school, phone number, date of birth, location."], ["Give one sign that a message might be phishing.", "Any one: urgency, strange sender, link, prize, asks for a password."], ["Who should they tell if something online worries them?", "A trusted adult, such as a parent, carer or teacher."], ["Correct this myth: 'If my account is private, nothing I post can ever be shared.'", "Followers can still screenshot and share posts, so think before posting even on a private account."]],
  x: ["Which success criterion did you meet best? Which needs work?", "A self-assessment against the three criteria."] },
{ t: "Feedback, improvement and reflection", o: "I can use feedback to improve my work and reflect on my learning.",
  k: ["feedback: comments that help you improve", "reflection: thinking about what you learned and how", "target: a specific thing to work on next"],
  d: ["What is more useful: 'Good work' or 'Your phishing section needs one more warning sign'? Why?", "The second, because it says exactly what to improve."],
  s: ["Reading your feedback|Find one strength and one next step|Check your level against each outcome|Ask if anything is unclear",
      "Improving|Use a different colour or a new version so the change is visible|Fix accuracy first, then presentation|Save as version 2",
      "Looking back|What can I do now that I could not do six weeks ago?|What mistake taught me the most?|What question do I still have?"],
  a: "Read your feedback and improve your guide, saving it as version 2. Then complete the unit reflection and set one target for the next unit. Support: your teacher has highlighted the one section to improve. Stretch: peer-review a partner's guide using the success criteria and give one strength and one next step.",
  w: [["Copy your next-step comment and write what you will change.", "The student's own feedback and a specific change."], ["Name one thing you can do now that you could not do at the start of the unit.", "Any skill from the unit, for example organise files or spot phishing."], ["Describe one mistake you made and how you fixed it.", "A specific mistake and fix."], ["Write one question you still have about staying safe online.", "Any relevant question."], ["Set one target for the next unit and say how you will know you have met it.", "A specific, checkable target."]],
  x: ["In one sentence, what is the most important thing you learned in this unit?", "A clear statement linked to the unit's big question."] }
