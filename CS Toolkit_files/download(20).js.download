(function (T) { T.unit({ id: "8.3", title: "Web design with HTML and CSS", q: "How are web pages built, and what makes one good for its users?", lessons: [
{ t: "How browsers read HTML", o: "I can write the basic structure of an HTML page.",
  k: ["HTML: HyperText Markup Language, used to describe the content and structure of a web page", "tag: a label in angle brackets that marks the start or end of an element", "element: an opening tag, its content and its closing tag"],
  d: ["When you request a web page, what does the server actually send to your browser?", "A text file of HTML, which the browser turns into the page."],
  s: ["HTML|A markup language: it labels content, it does not calculate|Tags come in pairs: `<p>` opens, `</p>` closes|The browser reads the tags and displays the content",
      "The page skeleton|>> <!DOCTYPE html>|>> <html>|>>   <head><title>My page</title></head>|>>   <body>Content goes here</body>|>> </html>",
      "Head and body|`<head>`: information about the page, such as the title on the tab|`<body>`: everything shown on the page|Save as `index.html` and open it in a browser"],
  a: "Type the page skeleton, save it as `index.html` and open it in a browser. Change the title and the body text, refresh and see the change. Then label the parts of the printed page source. Support: fill in the missing closing tags in the starter file. Stretch: view the source of a real web page and find its `<title>` and `<body>`.",
  w: [["What does HTML stand for?", "HyperText Markup Language."], ["What is a tag?", "A label in angle brackets that marks the start or end of an element."], ["Write the closing tag for `<body>`.", "</body>"], ["Which part of the page holds the content the user sees?", "The body."], ["Explain why HTML is called a markup language and not a programming language.", "It labels and structures content. It does not make decisions, repeat steps or calculate."]],
  x: ["What file name is normally used for a site's first page?", "index.html"] },
{ t: "Headings, paragraphs and lists", o: "I can structure content with headings, paragraphs and lists.",
  k: ["heading: a title for a section, from `<h1>` (most important) to `<h6>`", "paragraph: a block of text, marked with `<p>`", "list item: one entry in a list, marked with `<li>`"],
  d: ["Look at a page of a textbook. How do you know which text is a title?", "It is larger, bolder and comes first: its structure is shown."],
  s: ["Headings and paragraphs|>> <h1>My hobbies</h1>|>> <h2>Football</h2>|>> <p>I play every Saturday.</p>|One `<h1>` per page; use headings in order",
      "Lists|Unordered (bullets): `<ul>` with `<li>` items|Ordered (numbers): `<ol>` with `<li>` items|>> <ul><li>Bread</li><li>Milk</li></ul>",
      "Structure, not looks|Tags say what the content is|A heading is a heading even if you later make it small|Screen readers and search engines rely on this"],
  a: "Mark up the plain text recipe on the sheet with one h1, two h2 headings, paragraphs, an unordered list of ingredients and an ordered list of steps. Support: add tags to the part-marked file. Stretch: add a nested list inside one list item.",
  w: [["Which tag is used for the most important heading?", "<h1>"], ["Which tag marks a paragraph?", "<p>"], ["What is the difference between `<ul>` and `<ol>`?", "ul is an unordered (bulleted) list. ol is an ordered (numbered) list."], ["Write the HTML for a bulleted list of two items: Red, Blue.", "<ul><li>Red</li><li>Blue</li></ul>"], ["Explain why you should not choose `<h3>` for a main title just because you prefer its size.", "Tags describe structure. Size is changed with CSS. Using the wrong level confuses screen readers and search engines."]],
  x: ["How many `<h1>` elements should a page have?", "One."] },
{ t: "Lab: build an About Me page", o: "I can create a structured web page of my own.",
  k: ["validate: to check that code follows the rules", "nesting: placing one element completely inside another", "refresh: to reload a page in the browser to see changes"],
  d: ["Spot the error: `<p>Hello <b>world</p></b>`", "The tags are closed in the wrong order. It should be <p>Hello <b>world</b></p>."],
  s: ["Plan|A title, three sections with headings, at least one list|Do not include private details such as your address|Sketch it first",
      "Build|Write a little, save, refresh|Close every tag you open|Indent nested elements so the structure is clear",
      "Check|Is there one h1?|Are tags nested correctly: last opened, first closed?|Does the tab show a sensible title?"],
  a: "Build an About Me page with a title, three sections (for example hobbies, favourite things, goals), paragraphs and both kinds of list. Check it against the checklist. Support: start from the template with the headings in place. Stretch: add a table of your weekly timetable using `<table>`, `<tr>` and `<td>`.",
  w: [["What does nesting mean in HTML?", "Placing one element completely inside another."], ["Fix: `<h2>Hobbies<h2>`", "<h2>Hobbies</h2>"], ["Why must you save and refresh to see a change?", "The browser shows the saved file. It does not update until it reloads it."], ["Which tag sets the text shown on the browser tab?", "<title>"], ["Explain the rule for closing nested tags.", "The element opened last must be closed first, so elements never overlap."]],
  x: ["Which checklist item did you have to fix?", "A named item."] },
{ t: "Links and images", o: "I can add links and images using correct file paths.",
  k: ["hyperlink: text or an image that takes the user to another page when clicked", "attribute: extra information inside an opening tag, such as `href` or `src`", "file path: the location of a file, written so the browser can find it"],
  d: ["What makes the World Wide Web a 'web'?", "Pages are connected to each other by links."],
  s: ["Links|>> <a href=\"https://www.example.com\">Visit Example</a>|`href` is the address to go to|The text between the tags is what the user clicks",
      "Images|>> <img src=\"images/cat.jpg\" alt=\"A grey cat asleep\">|`src` is the path to the image file|`alt` describes the image for people who cannot see it|`<img>` has no closing tag",
      "File paths|`cat.jpg`: in the same folder as the page|`images/cat.jpg`: inside a folder called images|Names must match exactly, including capital letters"],
  a: "Add to your About Me page: two links to other websites, one link to a second page you create, and two images stored in an `images` folder with alt text. Support: copy the link and image patterns from the card and change the details. Stretch: make an image into a link.",
  w: [["Which tag creates a link?", "<a>"], ["Which attribute holds the address a link goes to?", "href"], ["What is the `alt` attribute for?", "It describes the image for people who cannot see it and when the image fails to load."], ["An image is in a folder called `pics` and is named `dog.png`. Write the `src` value.", "pics/dog.png"], ["An image shows as a broken icon. Give two things to check.", "The file path and folder, and the exact file name including capitals and extension."]],
  x: ["Write a link to `page2.html` with the text Next page.", "<a href=\"page2.html\">Next page</a>"] },
{ t: "Copyright and image licences", o: "I can choose images I am allowed to use and credit them.",
  k: ["copyright: the legal right of creators to control how their work is used", "licence: permission that sets out how a work may be used", "attribution: giving credit to the creator"],
  d: ["You find a great photo with an image search. Can you put it on your website?", "Not unless you have permission or its licence allows it."],
  s: ["Copyright|Whoever creates a photo, drawing, song or text owns it automatically|Copying it without permission can break the law|'It was on the internet' is not permission",
      "Licences|Some creators allow reuse under a licence|Creative Commons licences say what you may do: use, change, sell|Many require attribution",
      "Safe choices|Your own photos and drawings|Images marked as free to reuse, with the credit given|Search using the usage rights filter"],
  a: "For each of the eight scenarios, decide whether the use is allowed and explain why. Then find two images you are allowed to use for your site and write the attribution for each. Support: sort the scenarios into allowed, not allowed and 'need to ask'. Stretch: explain the difference between licences that allow changes and those that do not.",
  w: [["What is copyright?", "The legal right of creators to control how their work is used."], ["Who owns the copyright of a photo you take?", "You do."], ["What is attribution?", "Giving credit to the creator of a work."], ["Give two sources of images you can safely use on your website.", "Your own images, and images with a licence that allows reuse."], ["A student says, 'I can use any image if I am not making money from it.' Explain why this is wrong.", "Copyright applies whether or not money is made. Permission or a suitable licence is still needed."]],
  x: ["What should you write under a Creative Commons image you use?", "An attribution: the creator and the licence."] },
{ t: "Lab: add a gallery and external links", o: "I can combine images, links and lists into a useful page.",
  k: ["gallery: a set of images shown together", "external link: a link to a page on a different website", "internal link: a link to another page on the same website"],
  d: ["What is the difference between an internal link and an external link?", "Internal goes to another page on your site. External goes to a different site."],
  s: ["Gallery page|Create `gallery.html`|Four to six images you are allowed to use|Each with alt text and a caption",
      "Links|Internal: back to `index.html`|External: three useful sites, in a list|Use clear link text, not 'click here'",
      "Check|Every image loads|Every link goes to the right place|Every image has an attribution where needed"],
  a: "Create a gallery page linked from your home page, with at least four licensed images, captions, attributions and a list of three external links. Test every link. Support: use the gallery template. Stretch: add a third page and a link from every page to every other page.",
  w: [["What is an external link?", "A link to a page on a different website."], ["Write an internal link back to the home page.", "<a href=\"index.html\">Home</a>"], ["Why is 'Read about volcanoes' better link text than 'click here'?", "It tells the user where the link goes, which also helps screen-reader users."], ["Why does every image need alt text?", "So that users who cannot see it still get the information."], ["Explain how you tested your links and what you would do if one failed.", "Click each one and check where it leads. For a failure, check the href spelling and the file's name and location."]],
  x: ["How many of your links worked first time?", "A number."] },
{ t: "CSS: selectors, colour and fonts", o: "I can use CSS to change how HTML elements look.",
  k: ["CSS: Cascading Style Sheets, used to control the appearance of a web page", "selector: the part of a CSS rule that says which elements to style", "property: the feature being changed, such as `color` or `font-size`"],
  d: ["HTML says what the content is. What do you think a second language might be needed for?", "To say what it should look like."],
  s: ["A CSS rule|>> h1 {|>>   color: navy;|>>   font-size: 32px;|>> }|Selector, then property: value; pairs inside braces",
      "Linking a stylesheet|Save the rules in `style.css`|In the head of the page:|>> <link rel=\"stylesheet\" href=\"style.css\">|One stylesheet can style every page",
      "Useful properties|`color` and `background-color`|`font-family` and `font-size`|`text-align: center`"],
  a: "Create `style.css`, link it to your pages and write rules for body, h1, h2 and p that set colours, fonts and alignment. Support: complete the stylesheet with the values missing. Stretch: use hexadecimal colour codes and explain what the three pairs of digits mean.",
  w: [["What does CSS stand for?", "Cascading Style Sheets."], ["In `p { color: red; }`, which part is the selector?", "p"], ["Which property changes the text colour?", "color"], ["Write a rule that makes all h2 headings green.", "h2 { color: green; }"], ["Explain one advantage of keeping CSS in a separate file.", "One file can style every page, so a change is made once and the whole site updates."]],
  x: ["Name the two languages used so far and the job of each.", "HTML for content and structure; CSS for appearance."] },
{ t: "Classes and ids", o: "I can style particular elements using classes and ids.",
  k: ["class: a name given to a group of elements so they can be styled together", "id: a unique name given to one element", "specific: applying to a particular element, not all of them"],
  d: ["You want only one paragraph to be highlighted, not all of them. Why is the selector `p` not enough?", "It selects every paragraph."],
  s: ["Classes|In HTML: `<p class=\"warning\">`|In CSS: `.warning { color: red; }`|The same class can be used on many elements",
      "Ids|In HTML: `<div id=\"header\">`|In CSS: `#header { background-color: navy; }`|An id is used once per page",
      "Grouping content|`<div>` is a box used to group elements|Give it a class or id, then style the whole group|Example: a `div` for the header, one for the main content"],
  a: "Add classes and ids to your pages: a highlighted paragraph class, a header id and a footer id, with CSS for each. Support: add the class names shown on the card and copy the matching rules. Stretch: apply two classes to one element and explain what happens if they disagree.",
  w: [["How is a class selected in CSS?", "With a dot, for example .warning"], ["How is an id selected in CSS?", "With a hash, for example #header"], ["How many elements on a page can share the same id?", "One."], ["Write the CSS to give every element with class `note` a yellow background.", ".note { background-color: yellow; }"], ["Explain when you would use a class instead of an id.", "When several elements need the same style. An id is for one unique element."]],
  x: ["Which symbol selects a class and which selects an id?", "Dot for class, hash for id."] },
{ t: "Lab: restyle the same page three ways", o: "I can show that CSS changes appearance without changing content.",
  k: ["theme: a set of colours and fonts that go together", "contrast: the difference in brightness between text and its background", "consistent: the same throughout"],
  d: ["If you swap one stylesheet for another, what happens to the words on the page?", "Nothing. Only the appearance changes."],
  s: ["The idea|One HTML file|Three stylesheets: `plain.css`, `dark.css`, `fun.css`|Change one line in the head to switch",
      "Design choices|Two or three colours that go together|One font for headings, one for body text|Enough contrast to read easily",
      "Compare|Which is easiest to read?|Which suits the content?|Ask a partner to rank them"],
  a: "Write three different stylesheets for your home page and switch between them. Screenshot each and write which is best for your audience and why. Support: modify the three starter stylesheets. Stretch: add a rule that changes a link's colour when the mouse is over it (`a:hover`).",
  w: [["What stays the same when you switch stylesheets?", "The HTML content and structure."], ["What is contrast?", "The difference in brightness between text and its background."], ["Why is pale grey text on a white background a poor choice?", "The contrast is too low, so it is hard to read."], ["What does consistent design mean?", "The same colours, fonts and layout are used throughout the site."], ["Explain why separating content from presentation makes a website easier to maintain.", "The look of the whole site can be changed in one stylesheet without touching the pages, and content can be edited without breaking the design."]],
  x: ["Which of your three themes did your partner rank first?", "A named theme."] },
{ t: "The box model", o: "I can use margin, border and padding to space elements.",
  k: ["padding: the space between an element's content and its border", "border: the line around an element", "margin: the space outside the border, between elements"],
  d: ["A framed picture has a mount around the photo, then the frame, then a gap before the next picture. Which is like padding, border and margin?", "Mount is padding, frame is border, gap is margin."],
  s: ["Every element is a box|Content in the middle|Padding around the content|Border around the padding|Margin outside the border",
      "In CSS|>> .card {|>>   padding: 16px;|>>   border: 2px solid navy;|>>   margin: 20px;|>> }",
      "Size|`width: 300px` sets the content width|Padding and border are added on top unless told otherwise|Use the browser's inspect tool to see the box"],
  a: "Label the box model diagram, then add a `card` class to three sections of your page with padding, a border and a margin. Use the browser's inspect tool to see each box. Support: copy the card rule and change the numbers. Stretch: calculate the total width of a box that is 300px wide with 16px padding and a 2px border on each side.",
  w: [["What is padding?", "The space between an element's content and its border."], ["What is a margin?", "The space outside the border, between elements."], ["Put in order from inside to outside: border, margin, content, padding.", "Content, padding, border, margin."], ["Write a rule giving `.box` a 1px solid black border.", ".box { border: 1px solid black; }"], ["A box is 300px wide with 16px padding and a 2px border on each side. What is its total width?", "300 + 16 + 16 + 2 + 2 = 336px."]],
  x: ["Text is touching the edge of its coloured box. Which property fixes it?", "padding"] },
{ t: "Page layout and navigation bars", o: "I can lay out a page with a header, navigation, main content and footer.",
  k: ["layout: how the parts of a page are arranged", "navigation bar: a set of links to the main pages of a site", "semantic element: a tag whose name describes its purpose, such as `<nav>` or `<footer>`"],
  d: ["Think of a website you use. Where on the page do you look for the menu?", "Usually across the top or down the left side."],
  s: ["Page regions|`<header>`: the site name or logo|`<nav>`: the main links|`<main>`: the page's content|`<footer>`: credits and contact",
      "A navigation bar|>> <nav>|>>   <a href=\"index.html\">Home</a>|>>   <a href=\"gallery.html\">Gallery</a>|>> </nav>",
      "Styling it|Give `nav` a background colour and padding|Give the links padding and remove the underline with `text-decoration: none`|`display: flex` places items in a row"],
  a: "Restructure your home page with header, nav, main and footer elements, and style the navigation bar so the links sit in a row. Support: wrap your existing content using the layout template. Stretch: highlight the link for the page the user is currently on.",
  w: [["What is a navigation bar?", "A set of links to the main pages of a site."], ["Which element holds the main links of a site?", "<nav>"], ["What goes in a `<footer>`?", "Information such as credits, contact details or copyright."], ["Which CSS property removes the underline from links?", "text-decoration: none"], ["Explain why `<nav>` is better than `<div>` for a menu.", "Its name describes its purpose, which helps screen readers, search engines and other developers."]],
  x: ["Name the four regions of a typical page from top to bottom.", "Header, nav, main, footer."] },
{ t: "Lab: a consistent header and navigation", o: "I can make every page of a site look and navigate the same way.",
  k: ["consistent: the same on every page", "template: a page used as a starting point for others", "broken link: a link that does not lead to a page"],
  d: ["Why is it annoying when the menu is in a different place on each page of a site?", "Users have to search for it each time."],
  s: ["Consistency|The same header, navigation and footer on every page|The same stylesheet linked from every page|Only the main content changes",
      "Method|Finish one page and use it as a template|Copy it for each new page|Change the title and the main content",
      "Test the navigation|From every page, click every link|No broken links|You can always get home"],
  a: "Make your home page the template and apply the same header, navigation, footer and stylesheet to every page. Complete the link test grid (from each page to each page). Support: copy the template file twice and change only the main section. Stretch: add a 'skip to content' link for keyboard users.",
  w: [["What should be the same on every page of a site?", "The header, navigation, footer and styles."], ["What is a broken link?", "A link that does not lead to a page."], ["Why link the same stylesheet from every page?", "So all pages share one design and a change updates them all."], ["A site has 3 pages, each linking to the other two. How many links must you test?", "6."], ["Explain why consistent navigation makes a site easier to use.", "Users learn where things are once and can then find their way on every page."]],
  x: ["How many broken links did your test grid find?", "A number."] },
{ t: "Planning a site: audience, purpose and wireframe", o: "I can plan a website for a particular audience and purpose.",
  k: ["audience: the people a website is made for", "purpose: what the website is meant to achieve", "wireframe: a simple sketch showing where things go on a page"],
  d: ["How would a website for 5-year-olds differ from one for teachers?", "Larger text, more pictures and simpler words for children; more detail and plainer design for teachers."],
  s: ["Audience and purpose|Who is it for? Age, interests, what they already know|What is it for? To inform, persuade, entertain or sell|Every design decision follows from these",
      "Site map|A diagram of the pages and how they link|Three pages: home plus two others|Every page reachable from the home page",
      "Wireframe|Boxes and labels only: no colour, no detail|Shows header, navigation, content areas, images|Draw one for each page"],
  a: "Choose a topic and audience for a three-page site. Complete the planning sheet: audience, purpose, site map, a wireframe for each page and five success criteria. Support: choose one of the three briefs (a club, a place, a hobby). Stretch: plan how the layout should change on a phone screen.",
  w: [["What is meant by the audience of a website?", "The people it is made for."], ["What is a wireframe?", "A simple sketch showing where things go on a page."], ["Name three possible purposes of a website.", "Any three: inform, persuade, entertain, sell."], ["State your site's audience and purpose.", "A clear audience and purpose."], ["Explain one design decision you made because of your audience.", "A decision linked to the audience, for example large text and images for young children."]],
  x: ["Why are wireframes drawn without colour or detail?", "So the layout can be decided quickly before time is spent on appearance."] },
{ t: "Accessibility and usability checks", o: "I can check a web page for accessibility and usability.",
  k: ["accessibility: designing so that people with disabilities can use the site", "usability: how easy the site is to use", "screen reader: software that reads a page aloud for people who cannot see it"],
  d: ["How would someone who cannot see the screen know what an image shows?", "A screen reader reads out its alt text."],
  s: ["Accessibility|Alt text on every meaningful image|Strong contrast between text and background|Headings in order so the page can be navigated|Link text that makes sense out of context",
      "Usability|Clear navigation in the same place on each page|Short paragraphs and readable font sizes|Nothing essential shown by colour alone",
      "Checking|Use a contrast checker on your colours|Try to use the site with the keyboard only|Read the page with images switched off"],
  a: "Audit the sample website using the ten-point checklist and list the five most serious problems with a fix for each. Then run the same checklist on your own pages. Support: check the five points marked with a star. Stretch: test your colours in a contrast checker and record the ratios.",
  w: [["What is accessibility?", "Designing so that people with disabilities can use the site."], ["What does a screen reader do?", "It reads the page aloud."], ["Give three things that make a page more accessible.", "Any three: alt text, good contrast, headings in order, clear link text, readable font size."], ["Why should information not be shown by colour alone?", "Some users cannot tell certain colours apart."], ["Explain how headings help a screen-reader user.", "The user can jump from heading to heading to find the section they want instead of listening to the whole page."]],
  x: ["Which accessibility check did your own page fail?", "A named check."] },
{ t: "Lab: build sprint, a three-page site", o: "I can build a website from my plan.",
  k: ["sprint: a short, focused period of building", "plan: the site map, wireframes and success criteria", "version: a saved stage of the work"],
  d: ["What will you build first, and why?", "The template page with header, navigation and footer, because every page uses it."],
  s: ["Order of work|Template page and stylesheet|Copy it for each page|Add content, then images",
      "Stay on plan|Follow your wireframes|Tick off success criteria as you meet them|Save a version at the end of each stage",
      "Quality|Close every tag|Alt text and attribution for every image|Test links as you add them"],
  a: "Build your three-page site from your plan: template, pages, content, images and styles. Tick off your success criteria as you go. Support: use the site starter folder. Stretch: add a contact form layout (it does not need to send anything).",
  w: [["Which page did you build first?", "The template or home page."], ["How many of your success criteria are met so far?", "A number out of 5."], ["List the images you used and where each came from.", "A list with sources."], ["Describe one problem you solved today.", "A problem and its solution."], ["What remains to be done before testing?", "A list of remaining tasks."]],
  x: ["Does every page use the same stylesheet and navigation?", "Yes, or what still needs fixing."] },
{ t: "User testing", o: "I can test a website with a user and act on what I learn.",
  k: ["user testing: watching a real person use the site to find problems", "task: something the tester is asked to do", "observation: what you notice while the tester works"],
  d: ["Why should you stay quiet while someone tests your website?", "So you see what they really do, not what you tell them to do."],
  s: ["Set tasks|'Find the opening times'|'Go to the gallery and back home'|Three tasks that match the site's purpose",
      "Observe|Where did they hesitate?|Did they click something that was not a link?|Did they complete each task?",
      "Act|List the problems|Fix the ones that stopped a task being completed first|Retest"],
  a: "Write three tasks for your site, swap with a partner and observe them using the testing form. Record problems, then fix the two most important. Support: use the task examples on the card. Stretch: test with a second user and compare the results.",
  w: [["What is user testing?", "Watching a real person use the site to find problems."], ["Write one of the tasks you set.", "A task suited to the site."], ["What did your tester find difficult?", "A specific observation."], ["What did you change as a result?", "A specific change."], ["Explain why the person who built a site is a poor tester of it.", "They already know where everything is and how it is meant to work."]],
  x: ["Did your tester complete all three tasks?", "Yes, or which one failed."] },
{ t: "Assessed submission and evaluation", o: "I can evaluate my website against its plan.",
  k: ["evaluate: to judge how well something meets its aims", "evidence: something that supports a judgement", "improvement: a change that would make it better"],
  d: ["What is the difference between describing your website and evaluating it?", "Describing says what it has. Evaluating judges how well it works, with reasons."],
  s: ["Hand in|Three linked pages and one stylesheet|Plan: site map and wireframes|Accessibility checklist and user-testing form",
      "Evaluate|Take each success criterion in turn|Met, partly met or not met, with evidence|Compare the finished pages with the wireframes",
      "Improvements|Name two specific improvements|Say why each would help the audience|Avoid 'I would make it better'"],
  a: "Complete final checks, submit your site, and write an evaluation covering each success criterion, how well the site suits its audience, and two improvements. Support: use the evaluation frame. Stretch: evaluate how your site would work on a phone.",
  w: [["Which success criteria did you meet fully?", "A list."], ["Give evidence for one criterion you met.", "Specific evidence, such as a test result."], ["How does your site suit its audience?", "A reason linked to the audience."], ["Describe one difference between your wireframe and the finished page, and why it changed.", "A difference with a reason."], ["State two specific improvements and why each would help.", "Two improvements with reasons."]],
  x: ["Which part of your site are you proudest of?", "A named part."] },
{ t: "Feedback and reflection", o: "I can use feedback to improve my website and reflect on my learning.",
  k: ["feedback: comments that help you improve", "strength: something done well", "target: a specific thing to work on next"],
  d: ["Name one HTML tag and one CSS property you can now use from memory.", "Any correct tag and property."],
  s: ["Read your feedback|Find your strength and next step|Check your level for each outcome|Ask about anything unclear",
      "Improve|Make the change your teacher suggested|Check the page still validates and the links still work|Save the final version",
      "Reflect|What can I build now that I could not before?|What makes a site good for its users?|What is my target?"],
  a: "Improve your site using the feedback and complete the unit reflection. Support: your teacher has named the one page to improve. Stretch: write a short guide to HTML and CSS for next year's Year 8.",
  w: [["Copy your next step and say what you changed.", "The feedback and the change."], ["Name one thing you can do now that you could not six weeks ago.", "A unit skill."], ["Which was harder: HTML structure or CSS styling? Why?", "A reasoned choice."], ["Give two things that make a website good for its users.", "Any two: clear navigation, accessible, consistent, suited to the audience, readable."], ["Set one target for the next unit.", "A specific target."]],
  x: ["In one sentence, how are web pages built?", "HTML describes the content and structure, CSS controls the appearance, and the browser combines them into the page."] }
] }); })(typeof module !== "undefined" ? require("../lessons.js") : window.Toolkit);
