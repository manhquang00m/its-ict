(function (T) {
var F = "Table: FILM\nFilmID  Title            Genre        Year  Rating  Minutes  Available\nF01     Ocean Deep       Documentary  2019  8.1     95       TRUE\nF02     Night Runner     Action       2021  6.5     118      TRUE\nF03     The Last Garden  Drama        2018  7.9     104      FALSE\nF04     Sky Patrol       Action       2022  5.8     101      TRUE\nF05     Laugh Out        Comedy       2020  6.9     88       TRUE\nF06     Silent Echo      Drama        2023  8.4     126      TRUE\nF07     Code Breakers    Documentary  2022  7.2     90       FALSE\nF08     Big Trouble      Comedy       2017  5.5     92       TRUE";
T.unit({ id: "9.5", title: "Databases and SQL", q: "How are large amounts of data stored so that questions can be answered quickly?", lessons: [
{ t: "Data, information and databases", o: "I can explain what a database is and why organisations use one.",
  k: ["data: raw facts and figures without context", "information: data that has been processed so it has meaning", "database: a structured, persistent store of data that can be searched and sorted"],
  d: ["Is '14, 17, 9' data or information? What would turn it into information?", "Data. Context turns it into information, for example 'test scores out of 20 for three students'."],
  s: ["Data and information|Data: 2026-11-16, 21, 4|Information: 'On 16 November it was 21 degrees and 4 students were absent'|Processing and context give data meaning",
      "Where databases are used|Schools: students, timetables, marks|Shops: products, stock, orders|Hospitals, banks, libraries, streaming services",
      "Why a database?|Holds large amounts of data in a fixed structure|Finds and sorts records quickly|Data is stored once, so it stays consistent"],
  a: "Sort the twelve cards into data and information, then list five databases that hold data about you and what each stores. Support: sort eight cards. Stretch: explain one problem a school would have if it kept student data in many separate spreadsheets.",
  w: [["What is the difference between data and information?", "Data is raw facts; information is data processed and given context so it has meaning."], ["What is a database?", "A structured, persistent store of data that can be searched and sorted."], ["Give two organisations that use databases and one thing each stores.", "For example a school storing student details, and a shop storing stock levels."], ["Turn this data into information: 08:15, 3B, 28.", "For example: Class 3B has 28 students registered at 08:15."], ["Explain why storing data once in a database is better than copying it into many files.", "Changes are made in one place, so the data stays consistent and does not contradict itself."]],
  x: ["Name one database that holds data about you.", "For example the school's student records or a streaming service account."] },
{ t: "Tables, records and fields", o: "I can identify tables, records and fields in a database.",
  k: ["table: a set of data about one type of thing, arranged in rows and columns", "record: one row of a table, holding all the data about one item", "field: one column of a table, holding one piece of data about every item"],
  d: ["In a class register, what does one row describe? What does one column describe?", "One row describes one student; one column describes one detail, such as their name, for every student."],
  s: ["Tables|Hold data about one type of thing: films, students, products|Each table has a name, such as FILM|A database can contain several tables",
      "Records and fields|Record: one row, one film|Field: one column, such as Title or Year|Every record has the same fields",
      "Counting|The FILM table on your worksheet has 8 records|It has 7 fields|A field name describes what it holds"],
  a: "Use the FILM table to answer the questions about records and fields, then design a table of your own for a school club with at least six fields and four example records. Support: label a record, a field and the table name on the printed table. Stretch: explain why a phone number field should not be split across two columns.",
  r: F,
  w: [["How many records are in the FILM table?", "8."], ["How many fields are in the FILM table?", "7."], ["Name the field that holds how long each film is.", "Minutes."], ["Give the data in the Genre field for record F06.", "Drama."], ["Explain the difference between a record and a field.", "A record is one row with all the data about one item. A field is one column with one piece of data about every item."]],
  x: ["Is 'Silent Echo, Drama, 2023, 8.4, 126, TRUE' a record or a field?", "A record (without its FilmID)."] },
{ t: "Lab: explore a prepared database", o: "I can search and sort a database using its built-in tools.",
  k: ["sort: to put records in order by a field", "filter: to show only records that match a condition", "query: a request for particular data from a database"],
  d: ["How would you find every Comedy film in the FILM table quickly?", "Filter (or query) on Genre = Comedy."],
  s: ["Open the database|Find the FILM table and its 8 records|Check the field names and the data in each|Do not change any data yet",
      "Sort and filter|Sort by Year, then by Rating, highest first|Filter to show only Action films|Filter to show films longer than 100 minutes",
      "Answer questions by eye|Which film is longest?|Which genre appears most?|How long would it take for a table of 8 million films?"],
  a: "Answer the ten questions using sort and filter, recording how you found each answer. Then estimate how long the same questions would take on paper for 10 000 records. Support: answer the first six. Stretch: write three questions of your own that need two conditions.",
  r: F,
  w: [["Which film has the highest rating?", "Silent Echo (8.4)."], ["Which films are Action films?", "Night Runner and Sky Patrol."], ["Which films are longer than 100 minutes?", "Night Runner, The Last Garden, Sky Patrol, Silent Echo."], ["How many films are available?", "6."], ["Explain why sorting and filtering are more useful as a table grows.", "Finding records by eye becomes impossibly slow; the database finds them instantly whatever the size."]],
  x: ["What is a query?", "A request for particular data from a database."] },
{ t: "Data types", o: "I can choose a suitable data type for each field.",
  k: ["data type: the kind of data a field holds", "text (alphanumeric): letters, digits and symbols", "Boolean: one of two values, TRUE or FALSE"],
  d: ["Should a phone number such as 07700 900123 be stored as an integer? Why?", "No. The leading 0 would be lost, and no one does arithmetic with phone numbers. Store it as text."],
  s: ["The data types|Text or alphanumeric: names, postcodes, phone numbers|Character: a single letter, such as a grade|Boolean: TRUE or FALSE",
      "Numbers and dates|Integer: whole numbers, such as Year or Minutes|Real: numbers with decimals, such as Rating or Price|Date/time: dates and times, which can be sorted and compared",
      "Choosing|Will you do arithmetic with it? Use a number type|Could it start with 0 or contain letters? Use text|Only two possible values? Use Boolean"],
  a: "Choose a data type for each field in the FILM table and for twelve fields from other tables, with a reason for any tricky ones. Support: choose from the six data type cards. Stretch: explain what could go wrong if Rating were stored as an integer.",
  r: F,
  w: [["What data type should the Year field be?", "Integer."], ["What data type should the Rating field be?", "Real."], ["What data type should the Available field be?", "Boolean."], ["What data type should a postcode field be?", "Text (alphanumeric)."], ["Explain why a phone number should be stored as text and not as an integer.", "A leading zero would be lost, it may contain spaces or symbols, and no arithmetic is done with it."]],
  x: ["Which data type holds a single letter grade such as B?", "Character."] },
{ t: "Primary keys", o: "I can choose a primary key and explain why it must be unique.",
  k: ["primary key: a field that holds a different value for every record, so each record can be identified", "unique: no two records have the same value", "identifier: a value that picks out exactly one record"],
  d: ["Two students in a school are both called Ali Khan. How does the school tell their records apart?", "Each has a unique student ID number."],
  s: ["Why a key is needed|Names, dates and genres can repeat|The database must find exactly one record|The primary key does this",
      "Choosing a key|It must be unique for every record|It should never be empty|It should not need to change",
      "Examples|FilmID in the FILM table|StudentID, ProductCode, OrderNumber|Often a code made up for the purpose"],
  a: "For six tables, decide which field should be the primary key and explain why the other fields are unsuitable. Then add a primary key to your club table from lesson 2. Support: choose from the highlighted fields. Stretch: explain why an email address can be a poor primary key even though it is usually unique.",
  r: F,
  w: [["What is a primary key?", "A field that holds a different value for every record, so each record can be identified."], ["Which field is the primary key of the FILM table?", "FilmID."], ["Why can Title not be the primary key?", "Two different films could have the same title."], ["Why can Genre not be the primary key?", "Many films share the same genre, so it is not unique."], ["Explain why a primary key should not need to change.", "Other data and systems refer to records by their key; changing it could break those links or create duplicates."]],
  x: ["Give one rule a primary key must follow.", "It must be unique (and never empty)."] },
{ t: "Lab: design a table for a scenario", o: "I can design a single-table database for a given scenario.",
  k: ["design: a plan for a database table: fields, data types and key", "scenario: a description of a real situation", "example data: sample records used to check a design"],
  d: ["A vet needs to store data about the animals it treats. List four fields it might need.", "For example AnimalID, Name, Species, DateOfBirth, OwnerPhone."],
  s: ["Read the scenario|Underline every piece of data mentioned|Each becomes a field|Choose clear field names without spaces",
      "Complete the design|Field name, data type, example data|Choose the primary key|One field for each fact",
      "Check with example data|Write three realistic records|Does every record fit?|Is any field trying to hold two facts?"],
  a: "Design a table for one of the three scenarios (a library, a sports club, a vet): fields, data types, primary key and three example records. Support: use the design template with the field names given. Stretch: identify one piece of data that would be better stored in a second table, and explain why.",
  w: [["What scenario did you choose?", "Library, sports club or vet."], ["List your fields and data types.", "A suitable list."], ["Which field is your primary key, and why?", "A unique field with a reason."], ["Write one example record.", "A record matching the design."], ["Explain why each field should hold only one fact.", "So data can be searched, sorted and validated properly, for example searching by surname is hard if the whole name is in one field."]],
  x: ["How many fields does your design have?", "A number."] },
{ t: "Validation rules for fields", o: "I can choose validation rules to keep data in a table sensible.",
  k: ["validation rule: a check applied to a field when data is entered", "range check: the value must be between two limits", "format check: the value must follow a pattern"],
  d: ["Someone enters 2087 as a film's Year. What check would catch it?", "A range check, for example Year between 1888 and the current year."],
  s: ["Checks|Presence: the field cannot be empty|Range: between limits, such as Rating 0 to 10|Length: a set number of characters, such as a 3-character FilmID",
      "More checks|Type: the right kind of data, such as a number|Format: a pattern, such as a letter then two digits: F01|Check digit: a digit calculated from the others to catch typing errors",
      "Validation is not accuracy|7.2 instead of 2.7 passes a range check|Validation keeps data sensible, not necessarily correct|Verification, such as double entry, helps with accuracy"],
  a: "Choose a validation rule for every field in the FILM table and for your own design, and write test data that each rule should accept and reject. Support: match the rules to the fields with the cards. Stretch: explain how a check digit catches two digits that have been swapped.",
  r: F,
  w: [["What is a validation rule?", "A check applied to a field when data is entered."], ["Suggest a validation rule for the Rating field.", "A range check: from 0 to 10."], ["Suggest a validation rule for the FilmID field.", "A format check (a letter F then two digits) or a length check of 3, plus a presence check."], ["Which check makes sure the Title field is not left empty?", "A presence check."], ["Explain why validation cannot guarantee that data is correct.", "It only checks data is sensible. A wrong value inside the allowed range, such as 7.2 for 2.7, still passes."]],
  x: ["Name four types of validation check.", "Any four: presence, range, length, type, format, check digit."] },
{ t: "Create a table and enter data", o: "I can create a database table with data types, a primary key and validation.",
  k: ["create: to set up a new table with its fields", "data entry: typing records into a table", "error message: a message telling the user that data failed validation"],
  d: ["What three things must you decide for every field before creating a table?", "Its name, its data type and any validation rule."],
  s: ["Create the table|Open the database software|Add each field with its data type|Set the primary key",
      "Add validation|Set a range for Rating and Year|Set Title as required|Write a helpful error message for each rule",
      "Enter data|Enter the eight FILM records exactly|Check each against the source|Save"],
  a: "Create the FILM table in the database software with correct data types, a primary key and three validation rules, then enter the eight records. Support: follow the step-by-step guide. Stretch: also create the table you designed for your scenario.",
  r: F,
  w: [["Which field did you set as the primary key?", "FilmID."], ["Which data type did you choose for Minutes?", "Integer."], ["Write one validation rule you set and its error message.", "For example Rating between 0 and 10, 'Rating must be from 0 to 10'."], ["Why should an error message say what is wrong and how to fix it?", "So the user can correct the data straight away."], ["How did you check that your data was entered accurately?", "For example a visual check against the source or double entry."]],
  x: ["How many records did you enter?", "8."] },
{ t: "Lab: test validation with good and bad data", o: "I can test that validation rules accept good data and reject bad data.",
  k: ["normal data: data that should be accepted", "abnormal data: data that should be rejected", "boundary data: data at the edge of the allowed range"],
  d: ["For Rating from 0 to 10, give a normal, a boundary and an abnormal value.", "For example 6.5; 10 (or 0); 11 or -1."],
  s: ["Plan|For each rule, choose normal, boundary and abnormal data|Write the expected result: accept or reject|Then test it",
      "Test|Try to enter each value|Record what happened|A rule that accepts abnormal data has failed",
      "Fix|Change the rule|Retest with the same data|Record the fix"],
  a: "Complete a test plan with at least nine tests across three validation rules, carry out every test and fix any rule that fails. Support: use the test plan with the data chosen. Stretch: find a value that passes all your rules but is still wrong, and suggest how to catch it.",
  w: [["What is boundary data?", "Data at the edge of the allowed range."], ["For Year from 1888 to 2026, give boundary data.", "1888 and 2026 (and 1887, 2027 just outside)."], ["For Year, give abnormal data.", "For example 3000, -5 or 'twenty'."], ["What should happen when abnormal data is entered?", "It is rejected with an error message."], ["Which of your tests failed, and how did you fix it?", "A specific test and fix."]],
  x: ["Why test with boundary data as well as normal data?", "Mistakes in rules, such as < instead of <=, only show at the boundary."] },
{ t: "SQL: SELECT and FROM", o: "I can write SQL to show chosen fields from a table.",
  k: ["SQL: Structured Query Language, used to search and manage databases", "SELECT: chooses which fields to show", "FROM: names the table to search"],
  d: ["You want only the titles from the FILM table, not every field. How might you ask the database?", "Name the field you want and the table: show Title from FILM."],
  s: ["The shape of a query|>> SELECT Title|>> FROM FILM;|Shows the Title of every record",
      "More than one field|>> SELECT Title, Year|>> FROM FILM;|Fields separated by commas|SELECT * shows every field",
      "Rules|Keywords in capitals by convention|Field and table names exactly as in the design|End with a semicolon"],
  a: "Write and run eight SELECT queries on the FILM table, predicting the output before each run. Support: complete the queries with the field names missing. Stretch: find out what SELECT DISTINCT Genre does and explain it.",
  r: F,
  w: [["What does SQL stand for?", "Structured Query Language."], ["Write a query to show the Title and Genre of every film.", "SELECT Title, Genre\nFROM FILM;"], ["What does SELECT * do?", "Shows every field."], ["How many rows does SELECT Title FROM FILM; return?", "8."], ["Explain the job of SELECT and the job of FROM.", "SELECT chooses which fields are shown. FROM names the table the data comes from."]],
  x: ["Which keyword names the table?", "FROM."] },
{ t: "WHERE with comparison operators", o: "I can use WHERE to show only the records that match a condition.",
  k: ["WHERE: gives a condition that records must meet", "condition: a test such as Year > 2020", "comparison operator: =, <>, <, >, <= or >="],
  d: ["Write the condition for films made after 2020.", "Year > 2020."],
  s: ["Filtering|>> SELECT Title, Year|>> FROM FILM|>> WHERE Year > 2020;|Returns 4 films",
      "Text and Boolean|>> WHERE Genre = 'Action'|Text values go in quotation marks|>> WHERE Available = TRUE",
      "Operators|= equal, <> not equal|< less than, > greater than|<= and >= include the boundary"],
  a: "Predict and then run ten WHERE queries, recording the results. Write queries to answer five questions in plain English. Support: complete the queries with the conditions missing. Stretch: write a query using <> and explain what it returns.",
  r: F,
  w: [["Write a query to show the titles of all Action films.", "SELECT Title\nFROM FILM\nWHERE Genre = 'Action';"], ["What does WHERE Year > 2020 return? Give the titles.", "Night Runner, Sky Patrol, Silent Echo, Code Breakers."], ["Write a query to show the titles of films rated 8 or more.", "SELECT Title\nFROM FILM\nWHERE Rating >= 8;"], ["Which films does that query return?", "Ocean Deep and Silent Echo."], ["Explain why 'Action' needs quotation marks but 2020 does not.", "Action is text; 2020 is a number."]],
  x: ["What does <> mean in SQL?", "Not equal to."] },
{ t: "Lab: query challenges", o: "I can turn questions in plain English into SQL queries.",
  k: ["plain English: everyday language", "translate: to express in a different form", "result set: the records a query returns"],
  d: ["Turn into SQL: 'Show the title and length of every film that is not available.'", "SELECT Title, Minutes FROM FILM WHERE Available = FALSE;"],
  s: ["Method|Which fields are wanted? They go after SELECT|Which table? It goes after FROM|What must be true? It goes after WHERE",
      "Levels|Bronze: one field, one condition|Silver: several fields, one condition|Gold: you choose what to ask",
      "Check|Predict the result set first|Run it|Does it answer the question that was asked?"],
  a: "Complete as many challenges as you can, recording each query and its result set. Support: complete bronze. Stretch: complete gold and write two challenges for a partner.",
  r: F,
  w: [["Write a query for the titles and years of Drama films.", "SELECT Title, Year\nFROM FILM\nWHERE Genre = 'Drama';"], ["Write a query for the titles of films shorter than 95 minutes.", "SELECT Title\nFROM FILM\nWHERE Minutes < 95;"], ["Give the result set of the previous query.", "Laugh Out, Code Breakers, Big Trouble."], ["Write a query for every field of film F04.", "SELECT *\nFROM FILM\nWHERE FilmID = 'F04';"], ["Explain how you check that a query answers the question asked.", "Predict the result from the table first, then compare it with what the query returns."]],
  x: ["Which level did you reach?", "Bronze, silver or gold."] },
{ t: "AND, OR and ORDER BY", o: "I can combine conditions and sort the results.",
  k: ["AND: both conditions must be true", "OR: at least one condition must be true", "ORDER BY: sorts the results by a field, ASC (ascending) or DESC (descending)"],
  d: ["Films that are Drama and available: how many in the FILM table?", "One: Silent Echo."],
  s: ["AND and OR|>> WHERE Genre = 'Drama' AND Available = TRUE|>> WHERE Genre = 'Comedy' OR Minutes < 91|The same logic as in Python and logic gates",
      "Sorting|>> SELECT Title, Rating|>> FROM FILM|>> ORDER BY Rating DESC;|ASC is the default: smallest first",
      "Order of clauses|SELECT, FROM, WHERE, ORDER BY|Always in that order|WHERE is optional; so is ORDER BY"],
  a: "Predict and run eight queries using AND, OR and ORDER BY. Explain why two of them return different results even though they look similar. Support: complete the queries with the operators missing. Stretch: write a query with both AND and OR, using brackets.",
  r: F,
  w: [["What does WHERE Genre = 'Drama' AND Available = TRUE return?", "Silent Echo."], ["What does WHERE Genre = 'Comedy' OR Minutes < 91 return?", "Laugh Out, Code Breakers, Big Trouble."], ["Write a query to list titles and ratings, highest rating first.", "SELECT Title, Rating\nFROM FILM\nORDER BY Rating DESC;"], ["Which film is first in that list, and which is last?", "First Silent Echo; last Big Trouble."], ["Explain why changing AND to OR usually returns more records.", "OR needs only one condition to be true, so more records match."]],
  x: ["Put the clauses in order: ORDER BY, FROM, WHERE, SELECT.", "SELECT, FROM, WHERE, ORDER BY."] },
{ t: "SUM and COUNT", o: "I can use SUM and COUNT to calculate from the data.",
  k: ["COUNT: returns the number of records that match", "SUM: returns the total of a numeric field for the matching records", "aggregate function: a function that calculates one value from many records"],
  d: ["How many films in the FILM table are available? How did you work it out?", "6, by counting the TRUE values."],
  s: ["COUNT|>> SELECT COUNT(*)|>> FROM FILM|>> WHERE Available = TRUE;|Returns 6",
      "SUM|>> SELECT SUM(Minutes)|>> FROM FILM|>> WHERE Genre = 'Action';|Returns 219",
      "Using them|COUNT works with any records|SUM needs a numeric field|Combine with WHERE to answer specific questions"],
  a: "Predict and run six queries using SUM and COUNT, then write queries to answer five questions a cinema manager might ask. Support: complete the queries with the functions missing. Stretch: work out how to find the average rating using SUM and COUNT.",
  r: F,
  w: [["What does COUNT return?", "The number of records that match."], ["Write a query to count the Documentary films.", "SELECT COUNT(*)\nFROM FILM\nWHERE Genre = 'Documentary';"], ["What does that query return?", "2."], ["What does SELECT SUM(Minutes) FROM FILM; return?", "814."], ["Explain why SUM cannot be used on the Title field.", "SUM adds numbers, and Title is text."]],
  x: ["What is the total length of the Action films?", "219 minutes."] },
{ t: "Lab: the database detective", o: "I can use SQL to solve a problem step by step.",
  k: ["evidence: facts that support a conclusion", "deduce: to reach a conclusion by reasoning", "narrow down: to reduce the possibilities step by step"],
  d: ["A film was borrowed and not returned. It is longer than 100 minutes and not a Drama. Which films fit?", "Night Runner and Sky Patrol."],
  s: ["The case|A film has gone missing from the school film club|Clues arrive one at a time|Each clue becomes a WHERE condition",
      "Work like a detective|Write a query for each clue|Combine clues with AND|Record each query and how many suspects remain",
      "Close the case|One record should remain|Write your conclusion with the evidence|Swap with another team to check"],
  a: "Solve the mystery in the extended database (FILM plus a BORROWER table), recording every query and the number of records it returns. Support: solve with the clue cards that give the field names. Stretch: write your own three-clue mystery for another team.",
  r: F,
  w: [["Write a query for the clue 'longer than 100 minutes and not a Drama'.", "SELECT Title\nFROM FILM\nWHERE Minutes > 100 AND Genre <> 'Drama';"], ["Which films does that query return?", "Night Runner and Sky Patrol."], ["Why is AND used to combine clues?", "Every clue must be true of the missing film."], ["How many queries did your team need?", "A number."], ["Explain why recording how many records each query returns helps.", "It shows each clue narrowing the suspects and makes it easy to spot a wrong condition."]],
  x: ["Which film was missing in your case?", "The answer from the case file."] },
{ t: "Personal data, privacy and the law", o: "I can explain why personal data must be protected and how the law helps.",
  k: ["personal data: information that identifies a living person", "data protection law: laws that control how organisations collect, store and use personal data", "consent: permission given freely and knowingly"],
  d: ["A shop's database stores your name, address and everything you have bought. What could go wrong?", "It could be stolen, shared, sold or used to target you without your agreement."],
  s: ["Personal data|Name, address, date of birth, ID numbers|Photos, location, medical and financial details|Some data is extra sensitive: health, religion, ethnicity",
      "Typical rules in data protection law|Collect only what is needed, for a stated purpose|Keep it accurate, secure, and no longer than needed|People can see the data held about them",
      "Keeping it safe|Access levels, encryption, backups|Staff training|Report breaches quickly"],
  a: "Read the four fictional scenarios and decide whether each organisation followed good data protection practice, naming the principle broken. Then write a short privacy notice for your club database. Support: use the principles cards. Stretch: research the data protection law in your own country and compare it with the principles here.",
  w: [["What is personal data?", "Information that identifies a living person."], ["Give two principles of data protection.", "Any two: collect only what is needed, use it only for the stated purpose, keep it accurate, keep it secure, do not keep it longer than needed, let people see their data."], ["What is consent?", "Permission given freely and knowingly."], ["A school keeps former students' medical records for 30 years for no reason. Which principle is broken?", "Data should not be kept longer than needed."], ["Explain how encryption helps a company meet data protection law.", "If the data is stolen it cannot be read without the key, so personal data stays protected."]],
  x: ["Name one right a person has over data held about them.", "For example to see it, to have it corrected, or to have it deleted."] },
{ t: "Assessed practical and written questions", o: "I can design a table and write SQL queries to answer questions.",
  k: ["practical: a task done on the computer", "specification: the description of what is needed", "accurate: exactly correct"],
  d: ["What four clauses can a 0478 query use, and in what order?", "SELECT, FROM, WHERE, ORDER BY (with SUM and COUNT in the SELECT)."],
  s: ["Part 1: practical|Design and create a table from a scenario|Data types, primary key, two validation rules|Enter the records given",
      "Part 2: queries|Five questions to answer with SQL|Record each query and its result|Predict first",
      "Part 3: written|Keys, data types and validation|Explain your choices|Use the correct terms"],
  a: "Complete the assessed practical and the written questions under test conditions. Support: an SQL syntax card is provided. Stretch: attempt the extension question on why real systems use more than one table.",
  r: F,
  w: [["State the most suitable data type for the Minutes field.", "Integer."], ["Write a query to show the title and year of films made before 2020, in alphabetical order of title.", "SELECT Title, Year\nFROM FILM\nWHERE Year < 2020\nORDER BY Title;"], ["Give the result of the query in question 2.", "Big Trouble, Ocean Deep, The Last Garden."], ["Write a query to count the films with a rating above 7 that are available.", "SELECT COUNT(*)\nFROM FILM\nWHERE Rating > 7 AND Available = TRUE;"], ["Explain why FilmID is a better primary key than Title.", "FilmID is unique for every record; two films could share a title."]],
  x: ["Which query took you longest, and why?", "A reflection."] },
{ t: "Feedback and reflection", o: "I can correct my queries and reflect on my learning.",
  k: ["correction: a rewritten answer that fixes a mistake", "syntax error: a query that breaks the rules of SQL", "target: a specific thing to work on next"],
  d: ["A query returns no records but should return two. Name two possible causes.", "For example a misspelt value, missing quotation marks, AND used instead of OR, or the wrong operator."],
  s: ["Read your feedback|Which mistakes were syntax and which were logic?|Did your queries answer the question asked?|Ask about anything unclear",
      "Correct|Rewrite and rerun every wrong query|Compare with your prediction|Fix any design choices marked",
      "Reflect|Where else are databases used in your life?|What can I do now that I could not before?|What is my target?"],
  a: "Correct every query you lost marks on by running it, then complete the unit reflection. Support: your teacher has marked the queries to correct. Stretch: explain to a partner how a streaming service might use SQL to suggest films.",
  w: [["Copy one wrong query and correct it.", "A corrected query."], ["Was your mistake syntax or logic?", "A labelled mistake."], ["Give one way a streaming service could use a query on its film table.", "For example finding all films in a genre the user watches, ordered by rating."], ["Name one thing you can do now that you could not six weeks ago.", "A unit skill."], ["Set one target for the next unit.", "A specific target."]],
  x: ["In one sentence, how are large amounts of data stored so that questions can be answered quickly?", "In database tables of records and fields with a primary key, which SQL queries can search, filter, sort and count instantly."] }
] }); })(typeof module !== "undefined" ? require("../lessons.js") : window.Toolkit);
